<Window x:Class="GamePort.Cashier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GamePort.Cashier.Views"
        xmlns:vm="clr-namespace:GamePort.Cashier.ViewModels"
        Title="وینگ‌پورت"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#F4F6FA">

    <Grid x:Name="MainGrid">
        <!-- Before login: LoginView fills the entire window -->
        <ContentControl x:Name="LoginContent" Grid.Row="0"/>

        <!-- After login: Sidebar + page content -->
        <Grid x:Name="ContentArea" Grid.Row="0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#0058BC">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="16,24,16,0">
                        <TextBlock Text="وینگ‌پورت" FontSize="18" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock x:Name="EmployeeNameText" Text="" FontSize="12"
                                   Foreground="#99FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,16">
                        <Separator Background="#40FFFFFF" Margin="0,0,0,8"/>
                        <Border x:Name="NavLogout" Cursor="Hand" CornerRadius="8"
                                Padding="12,10" MouseLeftButtonDown="NavLogout_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" FontSize="20"
                                           Foreground="#FFCDD2" Text="{StaticResource IconLogout}"/>
                                <TextBlock Text="خروج" Foreground="#FFCDD2" FontSize="14"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Margin="16,0">
                        <Border x:Name="NavDashboard" Cursor="Hand" CornerRadius="8"
                                Padding="12,10" Margin="0,0,0,4" Background="#33FFFFFF"
                                MouseLeftButtonDown="NavDashboard_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" FontSize="20"
                                           Foreground="White" Text="{StaticResource IconDashboard}"/>
                                <TextBlock Text="داشبورد" Foreground="White" FontSize="14"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="NavDevices" Cursor="Hand" CornerRadius="8"
                                Padding="12,10" Margin="0,0,0,4"
                                MouseLeftButtonDown="NavDevices_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" FontSize="20"
                                           Foreground="White" Text="{StaticResource IconComputer}"/>
                                <TextBlock Text="سیستم‌ها" Foreground="White" FontSize="14"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="NavUsers" Cursor="Hand" CornerRadius="8"
                                Padding="12,10" Margin="0,0,0,4"
                                MouseLeftButtonDown="NavUsers_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" FontSize="20"
                                           Foreground="White" Text="{StaticResource IconGroup}"/>
                                <TextBlock Text="کاربران" Foreground="White" FontSize="14"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="NavFinancial" Cursor="Hand" CornerRadius="8"
                                Padding="12,10" Margin="0,0,0,4"
                                MouseLeftButtonDown="NavFinancial_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" FontSize="20"
                                           Foreground="White" Text="{StaticResource IconPayments}"/>
                                <TextBlock Text="گزارشات مالی" Foreground="White" FontSize="14"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="NavSettings" Cursor="Hand" CornerRadius="8"
                                Padding="12,10" Margin="0,0,0,4"
                                MouseLeftButtonDown="NavSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" FontSize="20"
                                           Foreground="White" Text="{StaticResource IconSettings}"/>
                                <TextBlock Text="تنظیمات" Foreground="White" FontSize="14"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Page Content -->
            <ContentControl Grid.Column="1" x:Name="MainContent" Margin="8"/>
        </Grid>
    </Grid>
</Window>
