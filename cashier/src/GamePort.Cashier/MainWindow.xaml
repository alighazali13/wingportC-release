<Window x:Class="GamePort.Cashier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:GamePort.Cashier.Views"
        xmlns:vm="clr-namespace:GamePort.Cashier.ViewModels"
        Title="وینگ‌پورت"
        Height="720" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        FlowDirection="RightToLeft"
        Background="#0C0E12"
        StateChanged="MainWindow_StateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            NonClientFrameEdges="None" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Caption button base: flat, 46x36 -->
        <Style x:Key="CaptionBtn" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1B2027"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252A33"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close: red hover -->
        <Style x:Key="CaptionBtnClose" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C4121F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== CUSTOM TITLE BAR (always LTR physical layout) ===== -->
        <Border Grid.Row="0" Background="#11141A" BorderBrush="#1A2028"
                BorderThickness="0,0,0,1" FlowDirection="LeftToRight"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: GamePort icon + title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Width="20" Height="20" CornerRadius="4" Background="#243D5E"
                            BorderBrush="#4C8DFF" BorderThickness="1" Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#xE30A;" FontFamily="{StaticResource MaterialIcons}"
                                   FontSize="11" Foreground="#4C8DFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="GamePort Cashier" FontSize="12" FontWeight="Medium"
                               Foreground="#94A3B8" VerticalAlignment="Center"
                               FlowDirection="LeftToRight"/>
                </StackPanel>

                <!-- RIGHT: Minimize / Maximize / Close -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnMinimize" Style="{StaticResource CaptionBtn}"
                            Click="Minimize_Click"
                            AutomationProperties.Name="Minimize"
                            ToolTip="Minimize">
                        <Button.Content>
                            <Path Data="M 0,0 L 10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" SnapsToDevicePixels="True"/>
                        </Button.Content>
                    </Button>
                    <Button x:Name="BtnMaximize" Style="{StaticResource CaptionBtn}"
                            Click="Maximize_Click"
                            AutomationProperties.Name="Maximize"
                            ToolTip="Maximize">
                        <Button.Content>
                            <Path x:Name="MaxIcon" Data="M 0,0 H 10 V 10 H 0 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" Fill="Transparent" SnapsToDevicePixels="True"/>
                        </Button.Content>
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource CaptionBtnClose}"
                            Click="Close_Click"
                            AutomationProperties.Name="Close"
                            ToolTip="Close">
                        <Button.Content>
                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" SnapsToDevicePixels="True"/>
                        </Button.Content>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== BODY: Login (pre-auth) or ContentArea (post-auth) ===== -->
        <Grid Grid.Row="1">
            <!-- Before login: LoginView fills the area below the title bar -->
            <ContentControl x:Name="LoginContent"/>

            <!-- After login: TopBar + Sidebar + page content -->
            <Grid x:Name="ContentArea" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== TOP OPERATIONAL BAR ===== -->
            <Border Grid.Row="0" Background="#11141A" BorderBrush="#1A2028"
                    BorderThickness="0,0,0,1" Padding="14,0">
                <Grid Height="42" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Right: Station identity -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="5" Background="#243D5E"
                                BorderBrush="#4C8DFF" BorderThickness="1" Margin="0,0,8,0">
                            <TextBlock Text="&#xE30A;" FontFamily="{StaticResource MaterialIcons}"
                                       FontSize="12" Foreground="#4C8DFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="صندوق مرکزی شماره ۱" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#F1F5F9" VerticalAlignment="Center" FlowDirection="RightToLeft"/>
                        <TextBlock Text="  |  " FontFamily="JetBrains Mono" FontSize="11"
                                   Foreground="#1A2028" VerticalAlignment="Center"/>
                        <TextBlock FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" FlowDirection="RightToLeft">
                            <Run Text="صندوق‌دار: "/>
                            <Run x:Name="TopBarEmployeeName" Text="" FontWeight="Medium" Foreground="#F1F5F9"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Center: Clock -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Background="#161B22" CornerRadius="4" BorderBrush="#1A2028"
                                BorderThickness="1" Padding="10,3">
                            <TextBlock x:Name="TopBarClock" Text="00:00:00" FontFamily="JetBrains Mono"
                                       FontSize="12" FontWeight="Bold" Foreground="#F1F5F9"
                                       VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                        </Border>
                    </StackPanel>

                    <!-- Left: Info indicators -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#161B22" CornerRadius="4"
                                BorderBrush="#1A2028" BorderThickness="1" Padding="8,2">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="LAN: 1Gbps" FontFamily="JetBrains Mono" FontSize="10"
                                           Foreground="#94A3B8" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                            </StackPanel>
                        </Border>
                        <Border Width="1" Background="#1A2028" Margin="8,0"/>
                        <Border Background="#161B22" CornerRadius="4"
                                BorderBrush="#1A2028" BorderThickness="1" Padding="8,2" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="PostgreSQL: متصل" FontSize="10"
                                           Foreground="#94A3B8" VerticalAlignment="Center" FlowDirection="RightToLeft"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== BODY: Content (left) + Global Sidebar (right) =====
                 Physical order must stay deterministic under window RTL:
                   Col0 (left)  = page content
                   Col1 (right) = global GamePort sidebar -->
            <Grid Grid.Row="1" FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <!-- Global Sidebar (dark, Stitch-style) — physical RIGHT -->
                <Border Grid.Column="1" Background="#11141A" BorderBrush="#1A2028"
                        BorderThickness="1,0,0,0" FlowDirection="RightToLeft">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Brand / POS identity -->
                            <RowDefinition Height="Auto"/>
                            <!-- Main application navigation -->
                            <RowDefinition Height="*"/>
                            <!-- Bottom: Settings + logout + core info -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Brand header -->
                        <Border Grid.Row="0" BorderBrush="#1A2028" BorderThickness="0,0,0,1"
                                Padding="14,12">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="28" Height="28" CornerRadius="6" Background="#4C8DFF"
                                        Margin="0,0,10,0">
                                    <TextBlock Text="&#xE30A;" FontFamily="{StaticResource MaterialIcons}"
                                               FontSize="16" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="گیم‌پورت" FontSize="13" FontWeight="Bold"
                                               Foreground="#F1F5F9"/>
                                    <TextBlock Text="CASHIER POS-01" FontFamily="JetBrains Mono"
                                               FontSize="9" Foreground="#64748B" FlowDirection="LeftToRight"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Row 1: Main application navigation (upper/main portion) -->
                        <StackPanel Grid.Row="1" Margin="8,8,8,0">
                            <Border x:Name="NavDashboard" Cursor="Hand" CornerRadius="6"
                                    Padding="12,8" Margin="0,0,0,2" Background="#4C8DFF26"
                                    MouseLeftButtonDown="NavDashboard_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="CornerRadius" Value="6"/>
                                        <Setter Property="Padding" Value="12,8"/>
                                        <Setter Property="Margin" Value="0,0,0,2"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="Dashboard">
                                                <Setter Property="Background" Value="#243D5E"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="16"
                                               Foreground="#64748B" Text="{StaticResource IconDashboard}"/>
                                    <TextBlock Text="داشبورد" Foreground="#94A3B8" FontSize="12"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="NavDevices" Cursor="Hand" CornerRadius="6"
                                    Padding="12,8" Margin="0,0,0,2" Background="Transparent"
                                    MouseLeftButtonDown="NavDevices_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="16"
                                               Foreground="#64748B" Text="{StaticResource IconComputer}"/>
                                    <TextBlock Text="سیستم‌ها" Foreground="#94A3B8" FontSize="12"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="NavUsers" Cursor="Hand" CornerRadius="6"
                                    Padding="12,8" Margin="0,0,0,2" Background="Transparent"
                                    MouseLeftButtonDown="NavUsers_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="16"
                                               Foreground="#64748B" Text="{StaticResource IconGroup}"/>
                                    <TextBlock Text="کاربران" Foreground="#94A3B8" FontSize="12"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="NavFinancial" Cursor="Hand" CornerRadius="6"
                                    Padding="12,8" Margin="0,0,0,2" Background="Transparent"
                                    MouseLeftButtonDown="NavFinancial_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="16"
                                               Foreground="#64748B" Text="{StaticResource IconPayments}"/>
                                    <TextBlock Text="گزارشات مالی" Foreground="#94A3B8" FontSize="12"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Row 2: Bottom area — Settings anchored + logout + core info -->
                        <StackPanel Grid.Row="2" Margin="8,0,8,12">
                            <Border BorderBrush="#1A2028" BorderThickness="0,1,0,0" Padding="0,8,0,8">
                                <StackPanel>
                                <Border x:Name="NavSettings" Cursor="Hand" CornerRadius="6"
                                        Padding="12,8" Background="Transparent"
                                        AutomationProperties.AutomationId="NavSettings"
                                        MouseLeftButtonDown="NavSettings_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="CornerRadius" Value="6"/>
                                            <Setter Property="Padding" Value="12,8"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="Settings">
                                                    <Setter Property="Background" Value="#243D5E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="16"
                                                   Foreground="#64748B" Text="{StaticResource IconSettings}"/>
                                        <TextBlock Text="تنظیمات سیستم" Foreground="#94A3B8" FontSize="12"
                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="NavLogout" Cursor="Hand" CornerRadius="6"
                                        Padding="12,8" Background="Transparent" Margin="0,2,0,0"
                                        MouseLeftButtonDown="NavLogout_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="16"
                                                   Foreground="#64748B" Text="{StaticResource IconLogout}"/>
                                        <TextBlock Text="خروج" Foreground="#94A3B8" FontSize="12"
                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Border>
                                </StackPanel>
                            </Border>

                            <!-- Bottom system/core information treatment -->
                            <Grid Margin="4,0,4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="GamePort Core" FontFamily="JetBrains Mono"
                                           FontSize="9" Foreground="#475569" VerticalAlignment="Center"
                                           FlowDirection="LeftToRight"/>
                                <TextBlock Grid.Column="1" Text="v2.0.0" FontFamily="JetBrains Mono"
                                           FontSize="9" Foreground="#475569" VerticalAlignment="Center"
                                           FlowDirection="LeftToRight"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Page Content (physical LEFT) -->
                <ContentControl Grid.Column="0" x:Name="MainContent" Margin="0"/>

                <!-- Update Notification Banner -->
                <Border x:Name="UpdateBanner" Grid.Column="0" Grid.ColumnSpan="2"
                        Visibility="Collapsed"
                        Background="#1A0B2E" BorderBrush="#7C3AED"
                        BorderThickness="1" CornerRadius="8"
                        Padding="16,12" Margin="16"
                        VerticalAlignment="Top" Panel.ZIndex="50">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE86C;"
                                   FontFamily="{StaticResource MaterialIcons}" FontSize="22"
                                   Foreground="#7C3AED" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="نسخه جدید GamePort آماده نصب است" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#E0E0E0"/>
                            <TextBlock FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0">
                                <Run Text="نسخه فعلی: "/><Run x:Name="UpdateCurrentVer" Text=""/>
                                <Run Text="  |  "/>
                                <Run Text="نسخه جدید: "/><Run x:Name="UpdateNewVer" Text="" Foreground="#7C3AED" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="بروزرسانی و راه‌اندازی مجدد" Cursor="Hand"
                                    Background="#7C3AED" Foreground="White" FontSize="12"
                                    FontWeight="SemiBold" Padding="14,8" BorderThickness="0"
                                    Click="UpdateApply_Click" Margin="0,0,8,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#8B5CF6"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Content="بعداً" Cursor="Hand"
                                    Background="Transparent" Foreground="#9CA3AF" FontSize="12"
                                    Padding="12,8" BorderThickness="0"
                                    Click="UpdateDismiss_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1F2937"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        </Grid>
    </Grid>
</Window>
