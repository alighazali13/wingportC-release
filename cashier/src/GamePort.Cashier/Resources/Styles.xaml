<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ===== Fonts ===== -->
    <FontFamily x:Key="Vazirmatn">pack://application:,,,/Resources/Fonts/#Vazirmatn</FontFamily>
    <FontFamily x:Key="MaterialIcons">pack://application:,,,/Resources/Fonts/#Material Symbols Outlined</FontFamily>

    <!-- ===== Icon Glyphs ===== -->
    <sys:String x:Key="IconDashboard">&#xE871;</sys:String>
    <sys:String x:Key="IconComputer">&#xE30A;</sys:String>
    <sys:String x:Key="IconPayments">&#xE8A1;</sys:String>
    <sys:String x:Key="IconGroup">&#xE7EF;</sys:String>
    <sys:String x:Key="IconSettings">&#xE8B8;</sys:String>
    <sys:String x:Key="IconSupport">&#xF0E2;</sys:String>
    <sys:String x:Key="IconLogout">&#xE9BA;</sys:String>
    <sys:String x:Key="IconNotifications">&#xE7F4;</sys:String>
    <sys:String x:Key="IconAccount">&#xE853;</sys:String>
    <sys:String x:Key="IconGamepad">&#xEA28;</sys:String>
    <sys:String x:Key="IconWallet">&#xE850;</sys:String>
    <sys:String x:Key="IconEvent">&#xE878;</sys:String>
    <sys:String x:Key="IconPersonAdd">&#xE7FE;</sys:String>
    <sys:String x:Key="IconPlay">&#xE037;</sys:String>
    <sys:String x:Key="IconCheck">&#xE86C;</sys:String>
    <sys:String x:Key="IconWarning">&#xE002;</sys:String>
    <sys:String x:Key="IconLock">&#xE897;</sys:String>
    <sys:String x:Key="IconTrendingUp">&#xE8E5;</sys:String>
    <sys:String x:Key="IconSessions">&#xE8B5;</sys:String>
    <sys:String x:Key="IconReservation">&#xE616;</sys:String>
    <sys:String x:Key="IconGames">&#xE30C;</sys:String>
    <sys:String x:Key="IconReports">&#xE85C;</sys:String>
    <sys:String x:Key="IconEmployees">&#xE7FB;</sys:String>

    <!-- ===== Colors ===== -->
    <Color x:Key="PrimaryColor">#0058BC</Color>
    <Color x:Key="PrimaryContainerColor">#0070EB</Color>
    <Color x:Key="SecondaryColor">#4C4ACA</Color>
    <Color x:Key="SurfaceColor">#F9F9FF</Color>
    <Color x:Key="SurfaceContainerColor">#ECEDF9</Color>
    <Color x:Key="SurfaceContainerHighColor">#E6E8F3</Color>
    <Color x:Key="BackgroundColor">#F9F9FF</Color>
    <Color x:Key="OnSurfaceColor">#181C23</Color>
    <Color x:Key="OnSurfaceVariantColor">#414755</Color>
    <Color x:Key="OutlineColor">#717786</Color>
    <Color x:Key="OutlineVariantColor">#C1C6D7</Color>
    <Color x:Key="SystemGreenColor">#34C759</Color>
    <Color x:Key="SystemRedColor">#FF3B30</Color>
    <Color x:Key="SystemOrangeColor">#FF9500</Color>

    <!-- ===== Brushes ===== -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#0058BC"/>
    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="#0070EB"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="#4C4ACA"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F9F9FF"/>
    <SolidColorBrush x:Key="SurfaceContainerBrush" Color="#ECEDF9"/>
    <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="#E6E8F3"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F9F9FF"/>
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="#181C23"/>
    <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="#414755"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="#717786"/>
    <SolidColorBrush x:Key="OutlineVariantBrush" Color="#C1C6D7"/>
    <SolidColorBrush x:Key="SystemGreenBrush" Color="#34C759"/>
    <SolidColorBrush x:Key="SystemRedBrush" Color="#FF3B30"/>
    <SolidColorBrush x:Key="SystemOrangeBrush" Color="#FF9500"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#4DC1C6D7"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="GlassBackgroundBrush" Color="#B3FFFFFF"/>

    <!-- ===== Text Styles ===== -->
    <Style x:Key="TextBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Vazirmatn}"/>
        <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style x:Key="DisplayStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="40"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="HeadlineStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="TitleLgStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="TitleMdStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="BodyLgStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style x:Key="BodyStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style x:Key="LabelMdStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource OnSurfaceVariantBrush}"/>
    </Style>

    <Style x:Key="LabelSmStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource OnSurfaceVariantBrush}"/>
    </Style>

    <!-- ===== Icon Style ===== -->
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MaterialIcons}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="{StaticResource OnSurfaceVariantBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- ===== Card Style ===== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- ===== Button Styles ===== -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource Vazirmatn}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Sidebar Nav Item Style ===== -->
    <Style x:Key="NavItem" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- ===== ScrollBar ===== -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

</ResourceDictionary>
