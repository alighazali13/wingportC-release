<UserControl x:Class="GamePort.Cashier.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource Vazirmatn}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Push button (white with border) -->
        <Style x:Key="PushButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#181C23"/>
            <Setter Property="FontFamily" Value="{StaticResource Vazirmatn}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="#C1C6D7" BorderThickness="1" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F3FE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary button (blue) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0058BC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource Vazirmatn}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#004493"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter tab button -->
        <Style x:Key="FilterTab" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#414755"/>
            <Setter Property="FontFamily" Value="{StaticResource Vazirmatn}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E6E8F3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status badge color helper is done inline via triggers -->

        <!-- ===== DEVICE CARD TEMPLATE ===== -->
        <DataTemplate x:Key="DeviceCardTemplate">
            <Border Background="White" BorderThickness="1" CornerRadius="12" Padding="20"
                    Margin="0,0,0,0" MinHeight="260">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#4DC1C6D7"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="InUse">
                                <Setter Property="BorderBrush" Value="#4D0070EB"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Locked">
                                <Setter Property="BorderBrush" Value="#4DFF9500"/>
                                <Setter Property="Background" Value="#0DFF9500"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Offline">
                                <Setter Property="Opacity" Value="0.85"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- status dot -->
                    <Ellipse Grid.Row="0" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#34C759"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="InUse">
                                        <Setter Property="Fill" Value="#0070EB"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Locked">
                                        <Setter Property="Fill" Value="#FF9500"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Offline">
                                        <Setter Property="Fill" Value="#FF3B30"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <!-- icon + name + status badge -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Border Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,12"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F1F3FE"/>
                                    <Setter Property="BorderBrush" Value="#4DC1C6D7"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="InUse">
                                            <Setter Property="Background" Value="#0D0070EB"/>
                                            <Setter Property="BorderBrush" Value="#330070EB"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Locked">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#33FF9500"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Offline">
                                            <Setter Property="Background" Value="#E0E2ED"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontFamily="{StaticResource MaterialIcons}" FontSize="32"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Icon}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#414755"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="InUse">
                                                <Setter Property="Foreground" Value="#0058BC"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Locked">
                                                <Setter Property="Foreground" Value="#FF9500"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                <Setter Property="Foreground" Value="#FF3B30"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#181C23" HorizontalAlignment="Center"/>

                        <Border CornerRadius="99" Padding="10,2" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#1A34C759"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="InUse">
                                            <Setter Property="Background" Value="#1A0070EB"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Locked">
                                            <Setter Property="Background" Value="#1AFF9500"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Offline">
                                            <Setter Property="Background" Value="#1AFF3B30"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#34C759"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="InUse">
                                                <Setter Property="Foreground" Value="#0058BC"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Locked">
                                                <Setter Property="Foreground" Value="#FF9500"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                <Setter Property="Foreground" Value="#FF3B30"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!-- details -->
                    <Grid Grid.Row="2" Margin="0,0,0,16">
                        <!-- default details (Available / Locked / Offline) -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="InUse">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Left" Text="نوع:" FontSize="12" Foreground="#414755"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TypeLabel}" FontSize="12"
                                           FontWeight="Medium" Foreground="#181C23" HorizontalAlignment="Left"/>
                            </DockPanel>

                            <!-- مشخصات (Available) -->
                            <DockPanel>
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Available">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <TextBlock DockPanel.Dock="Left" Text="مشخصات:" FontSize="12" Foreground="#414755"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Specs}" FontSize="12"
                                           FontWeight="Medium" Foreground="#181C23" HorizontalAlignment="Left"/>
                            </DockPanel>

                            <!-- دلیل (Locked) -->
                            <DockPanel>
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Locked">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <TextBlock DockPanel.Dock="Left" Text="دلیل:" FontSize="12" Foreground="#414755"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding LockReason}" FontSize="12"
                                           FontWeight="Medium" Foreground="#181C23" HorizontalAlignment="Left"/>
                            </DockPanel>

                            <!-- آخرین اتصال (Offline) -->
                            <DockPanel>
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <TextBlock DockPanel.Dock="Left" Text="آخرین اتصال:" FontSize="12" Foreground="#414755"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding LastConnection}" FontSize="12"
                                           FontWeight="Medium" Foreground="#181C23" HorizontalAlignment="Left"/>
                            </DockPanel>
                        </StackPanel>

                        <!-- active details (InUse) -->
                        <Border Background="#0D0070EB" CornerRadius="8" Padding="12,10" Margin="0,-20,-20,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="InUse">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Left" Text="کاربر:" FontSize="12" Foreground="#414755"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding User}" FontSize="12"
                                               FontWeight="Medium" Foreground="#181C23" HorizontalAlignment="Left"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Left" Text="زمان:" FontSize="12" Foreground="#414755"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" FontSize="13"
                                               FontWeight="Bold" Foreground="#0058BC" HorizontalAlignment="Left"
                                               FontFamily="Consolas"/>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="هزینه:" FontSize="12" Foreground="#414755"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Cost}" FontSize="12"
                                               FontWeight="Medium" Foreground="#181C23" HorizontalAlignment="Left"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- actions -->
                    <Grid Grid.Row="3">
                        <!-- Available -->
                        <Button HorizontalAlignment="Stretch">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PushButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Available">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource MaterialIcons}" FontSize="16"
                                           VerticalAlignment="Center" Text="&#xE8B8;"/>
                                <TextBlock Text="مدیریت" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Locked -->
                        <Button HorizontalAlignment="Stretch">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PushButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Locked">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource MaterialIcons}" FontSize="16"
                                           VerticalAlignment="Center" Text="&#xE898;"/>
                                <TextBlock Text="باز کردن" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Offline -->
                        <Button HorizontalAlignment="Stretch" IsEnabled="False">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PushButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Offline">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource MaterialIcons}" FontSize="16"
                                           VerticalAlignment="Center" Text="&#xE8B8;" Foreground="#717786"/>
                                <TextBlock Text="غیرفعال" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="#717786"/>
                            </StackPanel>
                        </Button>

                        <!-- InUse -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="InUse">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource MaterialIcons}" FontSize="16"
                                               VerticalAlignment="Center" Text="&#xE047;"/>
                                    <TextBlock Text="پایان" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource PushButton}" Padding="10,8">
                                <TextBlock FontFamily="{StaticResource MaterialIcons}" FontSize="18" Text="&#xE5D4;"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ===== LIST ROW TEMPLATE ===== -->
        <DataTemplate x:Key="DeviceRowTemplate">
            <Border Padding="0,12,0,12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#33C1C6D7"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="InUse">
                                <Setter Property="Background" Value="#030058BC"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Locked">
                                <Setter Property="Background" Value="#05FF9500"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- status dot -->
                    <Ellipse Grid.Column="0" Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#34C759"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="InUse">
                                        <Setter Property="Fill" Value="#0070EB"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Locked">
                                        <Setter Property="Fill" Value="#FF9500"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Offline">
                                        <Setter Property="Fill" Value="#FF3B30"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <!-- device name -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="8" BorderThickness="1" Margin="0,0,12,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F1F3FE"/>
                                    <Setter Property="BorderBrush" Value="#C1C6D7"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="InUse">
                                            <Setter Property="Background" Value="#1A0070EB"/>
                                            <Setter Property="BorderBrush" Value="#330070EB"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Locked">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#33FF9500"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Offline">
                                            <Setter Property="Background" Value="#E0E2ED"/>
                                            <Setter Property="BorderBrush" Value="#C1C6D7"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontFamily="{StaticResource MaterialIcons}" FontSize="18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Icon}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#414755"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="InUse">
                                                <Setter Property="Foreground" Value="#0058BC"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Locked">
                                                <Setter Property="Foreground" Value="#FF9500"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                <Setter Property="Foreground" Value="#FF3B30"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#181C23"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- type -->
                    <TextBlock Grid.Column="2" Text="{Binding TypeLabel}" FontSize="13" Foreground="#414755"
                               VerticalAlignment="Center"/>

                    <!-- status badge -->
                    <Border Grid.Column="3" CornerRadius="6" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#1A34C759"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="InUse">
                                        <Setter Property="Background" Value="#1A0070EB"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Locked">
                                        <Setter Property="Background" Value="#1AFF9500"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Offline">
                                        <Setter Property="Background" Value="#1AFF3B30"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#34C759"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="InUse">
                                            <Setter Property="Foreground" Value="#0058BC"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Locked">
                                            <Setter Property="Foreground" Value="#FF9500"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Offline">
                                            <Setter Property="Foreground" Value="#FF3B30"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- customer -->
                    <TextBlock Grid.Column="4" FontSize="13" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="-"/>
                                <Setter Property="Foreground" Value="#414755"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="InUse">
                                        <Setter Property="Text" Value="{Binding User}"/>
                                        <Setter Property="Foreground" Value="#181C23"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Locked">
                                        <Setter Property="Text" Value="{Binding LockReason}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- time -->
                    <TextBlock Grid.Column="5" FontSize="13" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="-"/>
                                <Setter Property="Foreground" Value="#414755"/>
                                <Setter Property="FontFamily" Value="{StaticResource Vazirmatn}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="InUse">
                                        <Setter Property="Text" Value="{Binding Time}"/>
                                        <Setter Property="Foreground" Value="#0058BC"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Offline">
                                        <Setter Property="Text" Value="{Binding LastConnection}"/>
                                        <Setter Property="Foreground" Value="#414755"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- actions -->
                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <!-- Available: managed button -->
                        <Button Padding="12,6" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PushButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Available">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource MaterialIcons}" FontSize="14" Text="&#xE8B8;" VerticalAlignment="Center"/>
                                <TextBlock Text="مدیریت" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Locked: unlock button -->
                        <Button Padding="12,6" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PushButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Locked">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource MaterialIcons}" FontSize="14" Text="&#xE898;" VerticalAlignment="Center"/>
                                <TextBlock Text="باز کردن" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Offline: disabled button -->
                        <Button Padding="12,6" IsEnabled="False">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PushButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Foreground" Value="#717786"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Offline">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource MaterialIcons}" FontSize="14" Text="&#xE8B8;"
                                           VerticalAlignment="Center" Foreground="#717786"/>
                                <TextBlock Text="غیرفعال" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                           Foreground="#717786"/>
                            </StackPanel>
                        </Button>

                        <!-- InUse: end + more -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="InUse">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Padding="12,6" Background="#0058BC" Foreground="White" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#0058BC" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource MaterialIcons}" FontSize="14" Text="&#xE047;"
                                               VerticalAlignment="Center" Foreground="White"/>
                                    <TextBlock Text="پایان" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                               Foreground="White"/>
                                </StackPanel>
                            </Button>
                            <Button Padding="8,6" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="4,0,0,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock FontFamily="{StaticResource MaterialIcons}" FontSize="18" Text="&#xE5D4;"
                                           Foreground="#414755"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24">
        <StackPanel>

            <!-- ===== PAGE HEADER ===== -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="دستگاه‌ها" FontSize="28" FontWeight="Bold" Foreground="#181C23"/>
                    <TextBlock Text="مدیریت و نظارت بر تمامی سیستم‌های گیم‌سنتر" FontSize="14"
                               Foreground="#414755" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Padding="16,10"
                        Command="{Binding AddDeviceCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource MaterialIcons}" FontSize="18" VerticalAlignment="Center" Text="&#xE145;"/>
                        <TextBlock Text="افزودن دستگاه" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ===== STATS ===== -->
            <ItemsControl ItemsSource="{Binding StatsCards}" Margin="0,0,0,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="6"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#4DC1C6D7" BorderThickness="1" CornerRadius="12"
                                Margin="4,0">
                            <Grid>
                                <StackPanel Margin="16,18" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Value}" FontSize="32" FontWeight="Bold"
                                               Foreground="{Binding ValueColor}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#414755" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Height="3" VerticalAlignment="Bottom" CornerRadius="0,0,12,12"
                                        Background="{Binding AccentColor}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== FILTER BAR ===== -->
            <Border Background="#B3FFFFFF" BorderBrush="#4DC1C6D7" BorderThickness="1" CornerRadius="12"
                    Padding="8" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- search -->
                    <Grid Grid.Column="0" Margin="0,0,16,0">
                        <Border Background="#F9F9FF" BorderBrush="#C1C6D7" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <TextBlock FontFamily="{StaticResource MaterialIcons}" FontSize="20"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                           Text="&#xE8B6;" Foreground="#717786"/>
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0" FontSize="13"
                                         FontFamily="{StaticResource Vazirmatn}" Foreground="#181C23"
                                         VerticalContentAlignment="Center" Padding="40,8,12,8"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- filters + toggle -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- type tabs -->
                        <Border Background="#E6E8F3" CornerRadius="8" Padding="4">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource FilterTab}" Content="همه"
                                        Background="#FFFFFF" Command="{Binding SetTypeFilterCommand}" CommandParameter="همه"/>
                                <Button Style="{StaticResource FilterTab}" Content="PC"
                                        Command="{Binding SetTypeFilterCommand}" CommandParameter="PC"/>
                                <Button Style="{StaticResource FilterTab}" Content="PS"
                                        Command="{Binding SetTypeFilterCommand}" CommandParameter="PS"/>
                            </StackPanel>
                        </Border>

                        <Border Width="1" Height="24" Background="#C1C6D7" Margin="10,0"/>

                        <!-- status dropdown -->
                        <ComboBox SelectedValue="{Binding StatusFilter}" FontFamily="{StaticResource Vazirmatn}"
                                  FontSize="13" Padding="10,6" Width="150">
                            <ComboBoxItem Content="همه وضعیت‌ها"/>
                            <ComboBoxItem Content="آماده"/>
                            <ComboBoxItem Content="در حال استفاده"/>
                            <ComboBoxItem Content="آفلاین"/>
                        </ComboBox>

                        <Border Width="1" Height="24" Background="#C1C6D7" Margin="10,0"/>

                        <!-- view toggle -->
                        <Border Background="#E6E8F3" CornerRadius="8" Padding="4">
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding SetGridViewCommand}" Padding="8" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsGridView, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#FFFFFF"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock FontFamily="{StaticResource MaterialIcons}" FontSize="18" Text="&#xE8B0;"/>
                                </Button>
                                <Button Command="{Binding SetListViewCommand}" Padding="8" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsGridView, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                                                <Setter TargetName="Bd" Property="Background" Value="#FFFFFF"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock FontFamily="{StaticResource MaterialIcons}" FontSize="18" Text="&#xE8EF;"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== GRID VIEW ===== -->
            <ItemsControl ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource DeviceCardTemplate}"
                          Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Width" Value="300"/>
                        <Setter Property="Margin" Value="0,0,20,20"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>

            <!-- ===== LIST VIEW ===== -->
            <Border Background="White" BorderBrush="#4DC1C6D7" BorderThickness="1" CornerRadius="12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGridView}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <!-- header -->
                    <Border Background="#F1F3FE" BorderBrush="#C1C6D7" BorderThickness="0,0,0,1"
                            CornerRadius="12,12,0,0" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontFamily="{StaticResource MaterialIcons}" FontSize="18"
                                       Text="&#xE5D4;" Foreground="#717786" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="دستگاه" FontSize="12" FontWeight="SemiBold" Foreground="#717786"/>
                            <TextBlock Grid.Column="2" Text="نوع" FontSize="12" FontWeight="SemiBold" Foreground="#717786"/>
                            <TextBlock Grid.Column="3" Text="وضعیت" FontSize="12" FontWeight="SemiBold" Foreground="#717786"/>
                            <TextBlock Grid.Column="4" Text="مشتری" FontSize="12" FontWeight="SemiBold" Foreground="#717786"/>
                            <TextBlock Grid.Column="5" Text="زمان استفاده" FontSize="12" FontWeight="SemiBold" Foreground="#717786"/>
                            <TextBlock Grid.Column="6" Text="عملیات" FontSize="12" FontWeight="SemiBold" Foreground="#717786"
                                       Margin="8,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- rows -->
                    <ItemsControl ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource DeviceRowTemplate}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
