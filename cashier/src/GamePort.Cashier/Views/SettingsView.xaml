<UserControl x:Class="GamePort.Cashier.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1100"
             FlowDirection="RightToLeft"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             FontFamily="{StaticResource Vazirmatn}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Segmented tab button -->
        <Style x:Key="SegmentTab" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#414755"/>
            <Setter Property="FontFamily" Value="{StaticResource Vazirmatn}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E6E8F3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outline / soft button -->
        <Style x:Key="SoftButton" TargetType="Button">
            <Setter Property="Background" Value="#F1F3FE"/>
            <Setter Property="Foreground" Value="#181C23"/>
            <Setter Property="FontFamily" Value="{StaticResource Vazirmatn}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0E2ED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0058BC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource Vazirmatn}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#004493"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24">
        <StackPanel>

            <!-- ===== PAGE HEADER ===== -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="تنظیمات سیستم" FontSize="28" FontWeight="Bold" Foreground="#181C23"/>
                        <Border Background="#E6E8F3" CornerRadius="99" Padding="10,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Version}" FontSize="11" Foreground="#414755"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="پیکربندی هویت ظاهری، مدیریت عناوین بازی‌ها و پارامترهای عمومی گیم‌سنتر"
                               FontSize="14" Foreground="#414755" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SoftButton}" Margin="0,0,10,0" Command="{Binding ResetCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="18" Text="&#xE042;" Margin="0,0,6,0"/>
                            <TextBlock Text="بازنشانی به پیش‌فرض" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="18" Foreground="White" Text="&#xE161;" Margin="0,0,6,0"/>
                            <TextBlock Text="ذخیره تغییرات" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===== SEGMENTED TABS ===== -->
            <Border Background="#F1F3FE" CornerRadius="12" Padding="4" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding SetTabCommand}" CommandParameter="Games">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SegmentTab}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Games">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="#0058BC"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="18" Text="{StaticResource IconGames}" Margin="0,0,6,0"/>
                            <TextBlock Text="مدیریت بازی‌ها و لانچر" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SetTabCommand}" CommandParameter="Appearance">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SegmentTab}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Appearance">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="#0058BC"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="18" Text="&#xE40A;" Margin="0,0,6,0"/>
                            <TextBlock Text="ظاهر و تم (پوسته)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SetTabCommand}" CommandParameter="Pricing">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SegmentTab}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Pricing">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="#0058BC"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="18" Text="&#xE8B8;" Margin="0,0,6,0"/>
                            <TextBlock Text="نرخ‌گذاری و تعرفه‌ها" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SetTabCommand}" CommandParameter="Network">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SegmentTab}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Network">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="#0058BC"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="18" Text="&#xE30A;" Margin="0,0,6,0"/>
                            <TextBlock Text="شبکه و کلاینت‌ها" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SetTabCommand}" CommandParameter="Security">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SegmentTab}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Security">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="#0058BC"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="18" Text="&#xE32A;" Margin="0,0,6,0"/>
                            <TextBlock Text="امنیت و دسترسی‌ها" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ===== APPEARANCE SECTION ===== -->
            <Border Background="White" BorderBrush="#4DC1C6D7" BorderThickness="1" CornerRadius="16"
                    Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <DockPanel Margin="0,0,0,20">
                        <Border DockPanel.Dock="Right" Background="#F1F3FE" CornerRadius="99" Padding="10,4"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#34C759" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="اعمال خودکار به ۴۲ سیستم متصل" FontSize="11" Foreground="#414755"/>
                            </StackPanel>
                        </Border>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" FontSize="20" Foreground="#0058BC"
                                           Text="&#xE40A;" Margin="0,0,8,0"/>
                                <TextBlock Text="حالت نمایش و تم نرم‌افزار" FontSize="16" FontWeight="SemiBold" Foreground="#181C23"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="انتخاب حالت رنگی رابط کاربری وینگ‌پورت برای محیط پنل سرور و استیشن‌های کلاینت"
                                       FontSize="13" Foreground="#414755" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Theme previews -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Light -->
                        <Border Grid.Column="0" CornerRadius="12" Padding="12" Margin="0,0,8,0" Cursor="Hand"
                                Background="#F1F3FE" BorderBrush="#4DC1C6D7" BorderThickness="1">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding SetThemeCommand}" CommandParameter="Light"/>
                            </Border.InputBindings>
                            <StackPanel>
                                <Border Height="110" Background="White" CornerRadius="8" Padding="8" Margin="0,0,0,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Ellipse Width="8" Height="8" Fill="#FF3B30" Margin="0,0,4,0"/>
                                            <Ellipse Width="8" Height="8" Fill="#FF9500" Margin="0,0,4,0"/>
                                            <Ellipse Width="8" Height="8" Fill="#34C759"/>
                                        </StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="3*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#ECEDF9" CornerRadius="4" Height="70" Margin="0,0,4,0"/>
                                            <StackPanel Grid.Column="1">
                                                <Border Height="14" Background="#E6E8F3" CornerRadius="4" Margin="0,0,0,4"/>
                                                <Border Height="48" Background="#F1F3FE" CornerRadius="4"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="روز و فضاهای پرنور" FontSize="11" Foreground="#717786"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="16" Height="16" Fill="#0058BC" Margin="0,0,6,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedTheme}" Value="Light">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="روشن (Light Mode)" FontSize="12" FontWeight="SemiBold" Foreground="#181C23"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Dark -->
                        <Border Grid.Column="1" CornerRadius="12" Padding="12" Margin="4,0" Cursor="Hand"
                                Background="#F1F3FE" BorderBrush="#4DC1C6D7" BorderThickness="1">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding SetThemeCommand}" CommandParameter="Dark"/>
                            </Border.InputBindings>
                            <StackPanel>
                                <Border Height="110" Background="#2D3039" CornerRadius="8" Padding="8" Margin="0,0,0,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Ellipse Width="8" Height="8" Fill="#FF3B30" Margin="0,0,4,0"/>
                                            <Ellipse Width="8" Height="8" Fill="#FF9500" Margin="0,0,4,0"/>
                                            <Ellipse Width="8" Height="8" Fill="#34C759"/>
                                        </StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="3*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#3A3D46" CornerRadius="4" Height="70" Margin="0,0,4,0"/>
                                            <StackPanel Grid.Column="1">
                                                <Border Height="14" Background="#454A54" CornerRadius="4" Margin="0,0,0,4"/>
                                                <Border Height="48" Background="#3A3D46" CornerRadius="4"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="محیط گیمینگ نئونی" FontSize="11" Foreground="#717786"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="16" Height="16" Fill="#0058BC" Margin="0,0,6,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedTheme}" Value="Dark">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="تاریک (Dark Mode)" FontSize="12" FontWeight="SemiBold" Foreground="#181C23"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Auto -->
                        <Border Grid.Column="2" CornerRadius="12" Padding="12" Margin="8,0,0,0" Cursor="Hand"
                                Background="#F1F3FE" BorderBrush="#4DC1C6D7" BorderThickness="1">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding SetThemeCommand}" CommandParameter="Auto"/>
                            </Border.InputBindings>
                            <StackPanel>
                                <Border Height="110" CornerRadius="8" Padding="8" Margin="0,0,0,10">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                                            <GradientStop Color="#FFFFFF" Offset="0"/>
                                            <GradientStop Color="#FFFFFF" Offset="0.5"/>
                                            <GradientStop Color="#2D3039" Offset="0.5"/>
                                            <GradientStop Color="#2D3039" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Ellipse Width="8" Height="8" Fill="#FF3B30" Margin="0,0,4,0"/>
                                            <Ellipse Width="8" Height="8" Fill="#FF9500" Margin="0,0,4,0"/>
                                            <Ellipse Width="8" Height="8" Fill="#34C759"/>
                                        </StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="3*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#C8CBD3" CornerRadius="4" Height="70" Margin="0,0,4,0"/>
                                            <StackPanel Grid.Column="1">
                                                <Border Height="14" Background="#D5D8DE" CornerRadius="4" Margin="0,0,0,4"/>
                                                <Border Height="48" Background="#E4E6EA" CornerRadius="4"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="بر اساس ساعت سیستم" FontSize="11" Foreground="#717786"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="16" Height="16" Fill="#0058BC" Margin="0,0,6,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedTheme}" Value="Auto">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="خودکار (هماهنگ با سیستم)" FontSize="12" FontWeight="SemiBold" Foreground="#181C23"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Accent color chooser -->
                    <Border Background="#80F1F3FE" CornerRadius="12" Padding="14" Margin="0,20,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="24" Height="24" CornerRadius="12" Background="#0058BC" Margin="0,0,10,0"
                                        BorderBrush="#181C23" BorderThickness="2"
                                        Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding SetAccentCommand}" CommandParameter="#0058BC"/>
                                    </Border.InputBindings>
                                </Border>
                                <Border Width="24" Height="24" CornerRadius="12" Background="#4C4ACA" Margin="0,0,10,0" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding SetAccentCommand}" CommandParameter="#4C4ACA"/>
                                    </Border.InputBindings>
                                </Border>
                                <Border Width="24" Height="24" CornerRadius="12" Background="#34C759" Margin="0,0,10,0" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding SetAccentCommand}" CommandParameter="#34C759"/>
                                    </Border.InputBindings>
                                </Border>
                                <Border Width="24" Height="24" CornerRadius="12" Background="#FF9500" Margin="0,0,10,0" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding SetAccentCommand}" CommandParameter="#FF9500"/>
                                    </Border.InputBindings>
                                </Border>
                                <Border Width="24" Height="24" CornerRadius="12" Background="#FF3B30" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding SetAccentCommand}" CommandParameter="#FF3B30"/>
                                    </Border.InputBindings>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" CornerRadius="10" Background="#D8E2FF" Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="18" Foreground="#0058BC" Text="&#xE40A;"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="رنگ شاخص سیستم (Accent Color)" FontSize="12" FontWeight="Medium" Foreground="#181C23"/>
                                    <TextBlock Text="رنگ برجسته‌سازی دکمه‌ها، برچسب‌ها و نشانگرهای کلاینت"
                                               FontSize="11" Foreground="#717786" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== GAME LIBRARY HEADER ===== -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="12" Background="#1A0058BC" Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource Icon}" FontSize="24" Foreground="#0058BC" Text="&#xE30C;"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="فهرست و پیکربندی بازی‌های نصب‌شده" FontSize="16" FontWeight="Bold" Foreground="#181C23"/>
                        <TextBlock Text="۴ عنوان بازی فعال • ۱۲۴ گیگابایت فضای کَش مشترک کلاینت"
                                   FontSize="11" Foreground="#717786" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White" BorderBrush="#C1C6D7" BorderThickness="1" CornerRadius="10"
                            Width="220" Margin="0,0,10,0">
                        <Grid>
                            <TextBlock Style="{StaticResource Icon}" FontSize="18" Foreground="#717786"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                       Text="&#xE8B6;"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" FontSize="12"
                                     FontFamily="{StaticResource Vazirmatn}" Foreground="#181C23"
                                     VerticalContentAlignment="Center" Padding="32,8,12,8"/>
                        </Grid>
                    </Border>
                    <ComboBox SelectedIndex="0" FontFamily="{StaticResource Vazirmatn}" FontSize="12"
                              Padding="10,7" Width="150" Margin="0,0,10,0">
                        <ComboBoxItem Content="همه دسته‌ها"/>
                        <ComboBoxItem Content="شوتر اول شخص"/>
                        <ComboBoxItem Content="ورزشی"/>
                        <ComboBoxItem Content="استراتژیک و MOBA"/>
                    </ComboBox>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ToggleAddGameCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="18" Foreground="White" Text="&#xE145;" Margin="0,0,6,0"/>
                            <TextBlock Text="افزودن بازی جدید" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===== ADD GAME FORM ===== -->
            <Border Background="#F1F3FE" CornerRadius="16" Padding="24" Margin="0,0,0,20"
                    Visibility="{Binding IsAddGameFormVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,20">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Padding="8"
                                Command="{Binding ToggleAddGameCommand}">
                            <TextBlock Style="{StaticResource Icon}" FontSize="18" Text="&#xE5CD;"/>
                        </Button>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="#0058BC" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ثبت بازی جدید در کتابخانه گیم‌سنتر" FontSize="16" FontWeight="SemiBold"
                                       Foreground="#181C23" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cover -->
                        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16" Margin="0,0,16,0"
                                MinHeight="190">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="56" Height="56" CornerRadius="16" Background="#1A0058BC"
                                        HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="28" Foreground="#0058BC" Text="&#xE439;"/>
                                </Border>
                                <TextBlock Text="انتخاب تصویر کاور" FontSize="12" FontWeight="Medium" Foreground="#181C23"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="فرمت‌های JPG یا WebP (نسبت ۱۶:۹ یا عمودی)" FontSize="11" Foreground="#717786"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <Border Background="#E6E8F3" CornerRadius="6" Padding="12,4" Margin="0,10,0,0">
                                    <TextBlock Text="یا تصویر را بکشید و اینجا رها کنید" FontSize="11" Foreground="#414755"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Fields -->
                        <StackPanel Grid.Column="1">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="نام رسمی بازی" FontSize="12" FontWeight="Medium" Foreground="#181C23" Margin="0,0,0,6"/>
                                    <Border Background="White" CornerRadius="8" Padding="12,9">
                                        <TextBox Background="Transparent" BorderThickness="0" FontSize="12"
                                                 FontFamily="{StaticResource Vazirmatn}" Foreground="#181C23"
                                                 Text="مثال: Counter-Strike 2"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="دسته‌بندی بازی" FontSize="12" FontWeight="Medium" Foreground="#181C23" Margin="0,0,0,6"/>
                                    <ComboBox SelectedIndex="0" FontFamily="{StaticResource Vazirmatn}" FontSize="12" Padding="10,8">
                                        <ComboBoxItem Content="شوتر اول شخص (FPS)"/>
                                        <ComboBoxItem Content="شبیه‌ساز ورزشی (Sports)"/>
                                        <ComboBoxItem Content="اکشن / ماجراجویی"/>
                                        <ComboBoxItem Content="استراتژیک و MOBA"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="مسیر فایل اجرایی بازی (Game Executable Path)" FontSize="12"
                                           FontWeight="Medium" Foreground="#181C23" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="12,9" Margin="0,0,8,0">
                                        <TextBox Background="Transparent" BorderThickness="0" FontSize="11"
                                                 FontFamily="Consolas" Foreground="#181C23" FlowDirection="LeftToRight"
                                                 Text="C:\Steam\steamapps\common\cs2\cs2.exe"/>
                                    </Border>
                                    <Button Grid.Column="1" Style="{StaticResource SoftButton}" Padding="14,9">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" FontSize="18" Text="&#xE2C8;" Margin="0,0,6,0"/>
                                            <TextBlock Text="انتخاب فایل..." VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="شناسه لانچر پلتفرم" FontSize="12" FontWeight="Medium" Foreground="#181C23" Margin="0,0,0,6"/>
                                    <ComboBox SelectedIndex="0" FontFamily="{StaticResource Vazirmatn}" FontSize="12" Padding="10,8">
                                        <ComboBoxItem Content="Steam (استیم)"/>
                                        <ComboBoxItem Content="EA App (الکترونیک آرتز)"/>
                                        <ComboBoxItem Content="Battle.net (بلیزارد)"/>
                                        <ComboBoxItem Content="Epic Games Launcher"/>
                                    </ComboBox>
                                </StackPanel>
                                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="12" Margin="8,20,0,0">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Width="44" Height="24" CornerRadius="12" Background="#0058BC">
                                            <Ellipse Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="نمایش در کلاینت کاربران" FontSize="12" FontWeight="Medium" Foreground="#181C23"/>
                                            <TextBlock Text="انتشار مستقیم روی مانیتور کلاینت‌ها" FontSize="10" Foreground="#717786" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
                                <Button Style="{StaticResource SoftButton}" Margin="0,0,10,0" Command="{Binding ToggleAddGameCommand}">
                                    <TextBlock Text="انصراف"/>
                                </Button>
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="18" Foreground="White" Text="&#xE02E;" Margin="0,0,6,0"/>
                                        <TextBlock Text="افزودن به لیست بازی‌ها" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== GAMES GRID ===== -->
            <ItemsControl ItemsSource="{Binding Games}" Margin="0,0,0,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Width" Value="288"/>
                        <Setter Property="Margin" Value="0,0,16,16"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#4DC1C6D7" BorderThickness="1" CornerRadius="16">
                            <StackPanel>
                                <!-- Cover -->
                                <Border Height="160" CornerRadius="16,16,0,0" ClipToBounds="True">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="{Binding CoverFrom}" Offset="0"/>
                                            <GradientStop Color="{Binding CoverTo}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <TextBlock Text="{Binding Badge}" FontSize="40" FontWeight="Bold" Foreground="#33FFFFFF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <!-- Status -->
                                        <Border Background="#E6FFFFFF" CornerRadius="99" Padding="10,4"
                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#34C759"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding NeedsUpdate}" Value="True">
                                                                    <Setter Property="Fill" Value="#FF9500"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Status}" FontSize="10" Foreground="#181C23"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- Name + badge -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Margin="12">
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="White"
                                                       VerticalAlignment="Center"/>
                                            <Border CornerRadius="4" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Background="{Binding BadgeColor}">
                                                <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Body -->
                                <StackPanel Margin="16,14">
                                    <DockPanel Margin="0,0,0,10">
                                        <Border DockPanel.Dock="Right" Background="#F1F3FE" CornerRadius="6" Padding="8,3">
                                            <TextBlock Text="{Binding SystemsCount}" FontSize="10" Foreground="#181C23"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" FontSize="16" Foreground="#0058BC"
                                                       Text="{Binding PlatformIcon}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Platform}" FontSize="11" FontWeight="Medium" Foreground="#181C23"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <Border Background="#F1F3FE" CornerRadius="8" Padding="10,6" Margin="0,0,0,12">
                                        <TextBlock Text="{Binding ExecPath}" FontSize="10" FontFamily="Consolas"
                                                   Foreground="#717786" TextTrimming="CharacterEllipsis"
                                                   FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Style="{StaticResource SoftButton}" Margin="0,0,8,0" Padding="12,7">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" FontSize="16" Text="&#xE3C9;" Margin="0,0,6,0"/>
                                                <TextBlock Text="ویرایش" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Style="{StaticResource SoftButton}" Padding="8,7">
                                            <TextBlock Style="{StaticResource Icon}" FontSize="18" Foreground="#717786" Text="&#xE872;"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== SYNC BANNER ===== -->
            <Border Background="#F1F3FE" CornerRadius="16" Padding="20">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SoftButton}" Background="White" Command="{Binding SyncClientsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" FontSize="18" Text="&#xE863;" Margin="0,0,6,0"/>
                                <TextBlock Text="بروزرسانی فوری کلاینت‌ها" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="12" Background="#1A34C759" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource Icon}" FontSize="24" Foreground="#34C759" Text="&#xE863;"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="پروتکل بروزرسانی درجا (P2P Client Deploy)" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#181C23"/>
                            <TextBlock Text="تمامی تغییرات لیست بازی‌ها بدون قطعی روی ۴۲ استیشن فعال شبکه‌سازی محلی منتشر می‌گردد."
                                       FontSize="11" Foreground="#717786" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
