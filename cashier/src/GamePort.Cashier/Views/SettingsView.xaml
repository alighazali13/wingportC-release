<UserControl x:Class="GamePort.Cashier.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GamePort.Cashier.ViewModels"
             xmlns:views="clr-namespace:GamePort.Cashier.Views"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1100"
             FlowDirection="LeftToRight"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             FontFamily="{StaticResource Vazirmatn}"
             Background="#0B0D10">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Category nav item style -->
        <Style x:Key="CategoryNavItem" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#161A20"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Selected category style via DataTrigger on parent -->
        <Style x:Key="CategoryLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Section card style -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#111419"/>
            <Setter Property="BorderBrush" Value="#1A2028"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Key-value cell -->
        <Style x:Key="KeyValueCell" TargetType="Border">
            <Setter Property="Background" Value="#161A20"/>
            <Setter Property="BorderBrush" Value="#1A2028"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!-- Soft button (dark) -->
        <Style x:Key="DarkSoftButton" TargetType="Button">
            <Setter Property="Background" Value="#161A20"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontFamily" Value="{StaticResource Vazirmatn}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="#1A2028" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1B2027"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary button (dark) -->
        <Style x:Key="DarkPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4C8DFF"/>
            <Setter Property="Foreground" Value="#0B0D10"/>
            <Setter Property="FontFamily" Value="{StaticResource Vazirmatn}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#67A0FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle switch -->
        <Style x:Key="ToggleSwitch" TargetType="Border">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background" Value="#1B2027"/>
            <Setter Property="BorderBrush" Value="#1A2028"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Placeholder view template -->
        <DataTemplate DataType="x:String">
            <Border Style="{StaticResource SectionCard}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE8B8;" FontFamily="{StaticResource MaterialIcons}" FontSize="40"
                               Foreground="#334155" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding}" FontSize="16" FontWeight="SemiBold"
                               Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock Text="این بخش در مرحله بعد پیاده‌سازی می‌شود."
                               FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- ===== MASTER / DETAIL LAYOUT =====
         Physical order (LTR, deterministic columns):
           Col0 (left)  = Settings content workspace
           Col1 (right) = Settings category nav (immediately left of global app sidebar)
         Window RTL must NOT reverse these structural columns. -->
    <Grid Background="#0B0D10" FlowDirection="LeftToRight">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="240"/>
        </Grid.ColumnDefinitions>

        <!-- ===== CONTENT WORKSPACE (physical LEFT) ===== -->
        <ScrollViewer Grid.Column="0" FlowDirection="RightToLeft"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="20,16,16,16">
            <StackPanel>

                <!-- ===== PAGE HEADER ===== -->
                <Border Background="#111419" BorderBrush="#1A2028" BorderThickness="1"
                        CornerRadius="8" Padding="20,14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="تنظیمات سیستم" FontSize="22" FontWeight="SemiBold"
                                           Foreground="#F1F5F9"/>
                                <Border Background="#1B2027" CornerRadius="4" Padding="8,2" Margin="10,0,0,0"
                                        VerticalAlignment="Center" BorderBrush="#1A2028" BorderThickness="1">
                                    <TextBlock Text="{Binding Version}" FontFamily="JetBrains Mono"
                                               FontSize="11" Foreground="#4C8DFF" FlowDirection="LeftToRight"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="پیکربندی و مدیریت رفتار GamePort در این شعبه"
                                       FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#161A20" BorderBrush="#1A2028"
                                BorderThickness="1" CornerRadius="6" Padding="12,6"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center">
                                    <Run Text="سطح دسترسی: "/>
                                    <Run Text="{Binding UserRole}" Foreground="#F1F5F9" FontWeight="Medium"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ===== CONTENT SECTIONS (switched by ActiveSection) ===== -->

                <!-- ===== مجموعه / ORGANIZATION ===== -->
                <StackPanel Visibility="{Binding ActiveSection, Converter={x:Static views:SettingsConverters.Organization}}">

                    <!-- Section 1: اطلاعات مجموعه -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="&#xEAF0;" FontFamily="{StaticResource MaterialIcons}"
                                               FontSize="20" Foreground="#4C8DFF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="اطلاعات مجموعه" FontSize="16" FontWeight="SemiBold"
                                               Foreground="#F1F5F9" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource DarkSoftButton}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE3C9;" FontFamily="{StaticResource MaterialIcons}"
                                                   FontSize="14" Foreground="#4C8DFF" Margin="0,0,6,0"/>
                                        <TextBlock Text="ویرایش اطلاعات" Foreground="#4C8DFF"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Key-Value Grid -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 1 -->
                                <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource KeyValueCell}" Margin="0,0,6,6">
                                    <StackPanel>
                                        <TextBlock Text="نام مجموعه" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock Text="هنوز پیکربندی نشده" FontSize="14" Foreground="#334155"
                                                   FontWeight="Medium" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource KeyValueCell}" Margin="3,0,3,6">
                                    <StackPanel>
                                        <TextBlock Text="شعبه" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock Text="هنوز پیکربندی نشده" FontSize="14" Foreground="#334155"
                                                   FontWeight="Medium" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource KeyValueCell}" Margin="6,0,0,6">
                                    <StackPanel FlowDirection="LeftToRight" HorizontalAlignment="Right">
                                        <TextBlock Text="کد شعبه" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
                                        <TextBlock Text="—" FontFamily="JetBrains Mono" FontSize="14"
                                                   Foreground="#334155" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Row 2 -->
                                <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource KeyValueCell}" Margin="0,0,6,6">
                                    <StackPanel FlowDirection="LeftToRight" HorizontalAlignment="Right">
                                        <TextBlock Text="منطقه زمانی" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
                                        <TextBlock Text="Asia/Tehran" FontFamily="JetBrains Mono" FontSize="13"
                                                   Foreground="#F1F5F9" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource KeyValueCell}" Margin="3,0,3,6">
                                    <StackPanel>
                                        <TextBlock Text="واحد پول" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock Text="تومان (IRR)" FontSize="14" Foreground="#F1F5F9"
                                                   FontWeight="Medium" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Grid.Row="1" Style="{StaticResource KeyValueCell}" Margin="6,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="زبان سیستم" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock Text="فارسی (RTL پیش‌فرض)" FontSize="14" Foreground="#F1F5F9"
                                                   FontWeight="Medium" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Row 3: Machine info (real) -->
                                <Border Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="3"
                                        Style="{StaticResource KeyValueCell}" Margin="0,0,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="نام سیستم" FontSize="11" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding MachineName}" FontFamily="JetBrains Mono"
                                                       FontSize="13" Foreground="#F1F5F9" Margin="0,2,0,0"
                                                       FlowDirection="LeftToRight"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" FlowDirection="LeftToRight" HorizontalAlignment="Right">
                                            <TextBlock Text="ارائه‌دهنده پایگاه داده" FontSize="11" Foreground="#64748B"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding DatabaseProvider}" FontFamily="JetBrains Mono"
                                                       FontSize="13" Foreground="#4C8DFF" Margin="0,2,0,0"
                                                       HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Section 2: خلاصه وضعیت عملیاتی -->
                    <Border Style="{StaticResource SectionCard}" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8A9;" FontFamily="{StaticResource MaterialIcons}"
                                           FontSize="19" Foreground="#4C8DFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="خلاصه وضعیت عملیاتی:" FontSize="13" Foreground="#F1F5F9"
                                           FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                <!-- PC count (real) -->
                                <Border Background="#161A20" BorderBrush="#1A2028" BorderThickness="1"
                                        CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE30A;" FontFamily="{StaticResource MaterialIcons}"
                                                   FontSize="14" Foreground="#4C8DFF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock FontFamily="JetBrains Mono" FontSize="12" Foreground="#F1F5F9"
                                                   VerticalAlignment="Center" FlowDirection="LeftToRight">
                                            <Run Text="{Binding PcCount, Mode=OneWay}"/>
                                            <Run Text=" PC"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- PS count (real) -->
                                <Border Background="#161A20" BorderBrush="#1A2028" BorderThickness="1"
                                        CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEA28;" FontFamily="{StaticResource MaterialIcons}"
                                                   FontSize="14" Foreground="#4C8DFF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock FontFamily="JetBrains Mono" FontSize="12" Foreground="#F1F5F9"
                                                   VerticalAlignment="Center" FlowDirection="LeftToRight">
                                            <Run Text="{Binding PsCount, Mode=OneWay}"/>
                                            <Run Text=" PS5"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Total (real) -->
                                <Border Background="#161A20" BorderBrush="#1A2028" BorderThickness="1"
                                        CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A9;" FontFamily="{StaticResource MaterialIcons}"
                                                   FontSize="14" Foreground="#4C8DFF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock FontFamily="JetBrains Mono" FontSize="12" Foreground="#F1F5F9"
                                                   VerticalAlignment="Center" FlowDirection="LeftToRight">
                                            <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                                            <Run Text=" کل"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Cloud status (real) -->
                                <Border Background="#161A20" BorderBrush="#1A2028" BorderThickness="1"
                                        CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE2C3;" FontFamily="{StaticResource MaterialIcons}"
                                                   FontSize="14" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock FontFamily="JetBrains Mono" FontSize="12" Foreground="#10B981"
                                                   VerticalAlignment="Center">
                                            <Run Text="Cloud: "/>
                                            <Run Text="{Binding CloudStatus, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- DB provider (real) -->
                                <Border Background="#161A20" BorderBrush="#1A2028" BorderThickness="1"
                                        CornerRadius="4" Padding="10,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource MaterialIcons}"
                                                   FontSize="14" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock FontFamily="JetBrains Mono" FontSize="12" Foreground="#94A3B8"
                                                   VerticalAlignment="Center" FlowDirection="LeftToRight">
                                            <Run Text="{Binding DatabaseProvider, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Section 3: ساعات کاری -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="&#xE32D;" FontFamily="{StaticResource MaterialIcons}"
                                               FontSize="20" Foreground="#4C8DFF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="ساعات کاری مجموعه" FontSize="16" FontWeight="SemiBold"
                                               Foreground="#F1F5F9" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource DarkSoftButton}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE863;" FontFamily="{StaticResource MaterialIcons}"
                                                   FontSize="14" Foreground="#64748B" Margin="0,0,6,0"/>
                                        <TextBlock Text="ویرایش ساعات کاری" Foreground="#64748B"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border BorderBrush="#1A2028" BorderThickness="0,1,0,0" Padding="0,10">
                                <StackPanel>
                                    <TextBlock Text="اطلاعات ساعات کاری هنوز پیکربندی نشده است."
                                               FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <TextBlock Text="پس از راه‌اندازی سرویس زمان‌بندی، این بخش به‌صورت خودکار پر می‌شود."
                                               FontSize="12" Foreground="#334155" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Section 4: رفتار و سیاست‌ها -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E6;" FontFamily="{StaticResource MaterialIcons}"
                                               FontSize="20" Foreground="#4C8DFF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="رفتار و سیاست‌های عملیاتی مجموعه" FontSize="16" FontWeight="SemiBold"
                                               Foreground="#F1F5F9" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#161A20" BorderBrush="#1A2028"
                                        BorderThickness="1" CornerRadius="4" Padding="8,3"
                                        VerticalAlignment="Center">
                                    <TextBlock FontFamily="JetBrains Mono" FontSize="11" Foreground="#94A3B8"
                                               FlowDirection="LeftToRight">
                                        <Run Text="۶"/>
                                        <Run Text=" سیاست"/>
                                    </TextBlock>
                                </Border>
                            </Grid>

                            <Border BorderBrush="#1A2028" BorderThickness="0,1,0,0" Padding="0,10">
                                <StackPanel>
                                    <TextBlock Text="سیاست‌های عملیاتی هنوز پیکربندی نشده‌اند."
                                               FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    <TextBlock Text="پس از تعریف سیاست‌ها توسط مدیر سیستم، این بخش فعال می‌شود."
                                               FontSize="12" Foreground="#334155" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== شبکه و دستگاه‌ها / NETWORK (Phase 2) ===== -->
                <Border Visibility="{Binding ActiveSection, Converter={x:Static views:SettingsConverters.Network}}">
                    <views:NetworkDevicesSettingsView DataContext="{Binding NetworkDevices}"/>
                </Border>

                <!-- ===== Cloud Sync و پشتیبان‌گیری / CLOUD SYNC ===== -->
                <StackPanel Visibility="{Binding ActiveSection, Converter={x:Static views:SettingsConverters.CloudSync}}">
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE2C3;" FontFamily="{StaticResource MaterialIcons}"
                                               FontSize="20" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Cloud Sync و پشتیبان‌گیری" FontSize="16" FontWeight="SemiBold"
                                               Foreground="#F1F5F9" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Sync status (real) -->
                            <Border Background="#161A20" BorderBrush="#1A2028" BorderThickness="1"
                                    CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="وضعیت همگام‌سازی Cloud" FontSize="14" Foreground="#F1F5F9"
                                                   FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding CloudStatus}" FontFamily="JetBrains Mono"
                                               FontSize="14" Foreground="#10B981" HorizontalAlignment="Left"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Button Style="{StaticResource DarkPrimaryButton}" HorizontalAlignment="Left"
                                    Command="{Binding SyncClientsCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE863;" FontFamily="{StaticResource MaterialIcons}"
                                               FontSize="16" Margin="0,0,8,0" Foreground="#0B0D10"/>
                                    <TextBlock Text="بروزرسانی فوری کلاینت‌ها" Foreground="#0B0D10"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#10B981"
                                       Margin="0,10,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== تنظیمات عمومی / GENERAL (preserves theme/accent) ===== -->
                <StackPanel Visibility="{Binding ActiveSection, Converter={x:Static views:SettingsConverters.General}}">
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B8;" FontFamily="{StaticResource MaterialIcons}"
                                               FontSize="20" Foreground="#4C8DFF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="تنظیمات عمومی" FontSize="16" FontWeight="SemiBold"
                                               Foreground="#F1F5F9" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Theme selector -->
                            <TextBlock Text="حالت نمایش" FontSize="13" FontWeight="Medium" Foreground="#F1F5F9"
                                       Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#161A20" BorderBrush="#1A2028"
                                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,6,0"
                                        Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding SetThemeCommand}" CommandParameter="Light"/>
                                    </Border.InputBindings>
                                    <StackPanel>
                                        <Border Height="60" Background="#F1F5F9" CornerRadius="6" Margin="0,0,0,8"/>
                                        <TextBlock Text="روشن" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="#161A20" BorderBrush="#1A2028"
                                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="3,0"
                                        Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding SetThemeCommand}" CommandParameter="Dark"/>
                                    </Border.InputBindings>
                                    <StackPanel>
                                        <Border Height="60" Background="#0B0D10" CornerRadius="6" Margin="0,0,0,8"
                                                BorderBrush="#1A2028" BorderThickness="1"/>
                                        <TextBlock Text="تاریک" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="#161A20" BorderBrush="#1A2028"
                                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="6,0,0,0"
                                        Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding SetThemeCommand}" CommandParameter="Auto"/>
                                    </Border.InputBindings>
                                    <StackPanel>
                                        <Border Height="60" CornerRadius="6" Margin="0,0,0,8">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#F1F5F9" Offset="0.5"/>
                                                    <GradientStop Color="#0B0D10" Offset="0.5"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Text="خودکار" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Accent color -->
                            <TextBlock Text="رنگ شاخص" FontSize="13" FontWeight="Medium" Foreground="#F1F5F9"
                                       Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" CornerRadius="16" Background="#4C8DFF"
                                        BorderBrush="#F1F5F9" BorderThickness="2" Cursor="Hand" Margin="0,0,10,0">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding SetAccentCommand}" CommandParameter="#4C8DFF"/>
                                    </Border.InputBindings>
                                </Border>
                                <Border Width="32" Height="32" CornerRadius="16" Background="#10B981"
                                        Cursor="Hand" Margin="0,0,10,0">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding SetAccentCommand}" CommandParameter="#10B981"/>
                                    </Border.InputBindings>
                                </Border>
                                <Border Width="32" Height="32" CornerRadius="16" Background="#F59E0B"
                                        Cursor="Hand" Margin="0,0,10,0">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding SetAccentCommand}" CommandParameter="#F59E0B"/>
                                    </Border.InputBindings>
                                </Border>
                                <Border Width="32" Height="32" CornerRadius="16" Background="#EF4444"
                                        Cursor="Hand" Margin="0,0,10,0">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding SetAccentCommand}" CommandParameter="#EF4444"/>
                                    </Border.InputBindings>
                                </Border>
                                <Border Width="32" Height="32" CornerRadius="16" Background="#8B5CF6"
                                        Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding SetAccentCommand}" CommandParameter="#8B5CF6"/>
                                    </Border.InputBindings>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Placeholder for all other sections ===== -->
                <StackPanel Visibility="{Binding ActiveSection, Converter={x:Static views:SettingsConverters.Other}}">
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40">
                            <Border Width="72" Height="72" CornerRadius="16" Background="#161A20"
                                    BorderBrush="#1A2028" BorderThickness="1" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8B8;" FontFamily="{StaticResource MaterialIcons}" FontSize="36"
                                           Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="تنظیمات سیستم" FontSize="18" FontWeight="SemiBold"
                                       Foreground="#F1F5F9" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                            <TextBlock Text="این بخش در مرحله بعد پیاده‌سازی می‌شود."
                                       FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ===== SETTINGS CATEGORY NAVIGATION (physical RIGHT, next to global sidebar) ===== -->
        <Border Grid.Column="1" FlowDirection="RightToLeft"
                Background="#111419" BorderBrush="#1A2028"
                BorderThickness="1,0,0,0" Padding="8,12,8,8">
            <DockPanel>
                <!-- Header -->
                <Border DockPanel.Dock="Top" BorderBrush="#1A2028" BorderThickness="0,0,0,1"
                        Padding="10,6" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="دسته‌بندی‌ها" FontSize="11"
                                   Foreground="#64748B" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" FontFamily="JetBrains Mono" FontSize="11"
                                   Foreground="#4C8DFF" VerticalAlignment="Center" FlowDirection="LeftToRight">
                            <Run Text="12"/>
                            <Run Text=" سرفصل"/>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Category items -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border MouseLeftButtonDown="Category_Click"
                                        Tag="{Binding Key}">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource CategoryNavItem}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#1B2027"/>
                                                    <Setter Property="BorderBrush" Value="#4C8DFF"/>
                                                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource MaterialIcons}"
                                                       FontSize="18" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="#4C8DFF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Label}" FontSize="13" Margin="10,0,0,0"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="#4C8DFF"/>
                                                                <Setter Property="FontWeight" Value="Medium"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="2" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="&#xE897;" FontFamily="{StaticResource MaterialIcons}"
                                                       FontSize="14" Foreground="#334155" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
