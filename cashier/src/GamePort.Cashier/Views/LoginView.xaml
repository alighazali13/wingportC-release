<UserControl x:Class="GamePort.Cashier.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" FontFamily="Vazirmatn"
             Background="#F4F6FA">

    <Grid Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Width="400" Padding="32" Background="White" CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="وینگ‌پورت" FontSize="22" FontWeight="Bold"
                           Foreground="#0058BC" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="1" Text="ورود به سیستم" FontSize="13"
                           Foreground="#888" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Grid.Row="2" Text="نام کاربری" FontSize="12" Foreground="#333" Margin="0,0,0,4"/>
                <TextBox Grid.Row="3" x:Name="UsernameBox"
                         Height="40" FontSize="14" VerticalContentAlignment="Center"
                         FlowDirection="LeftToRight" BorderBrush="#DDD" BorderThickness="1" Padding="10,0"/>

                <TextBlock Grid.Row="4" Text="رمز عبور" FontSize="12" Foreground="#333" Margin="0,12,0,4"/>
                <PasswordBox Grid.Row="5" x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged"
                             Height="40" FontSize="14" VerticalContentAlignment="Center"
                             FlowDirection="LeftToRight" BorderBrush="#DDD" BorderThickness="1"
                             Padding="10,0" KeyDown="PasswordBox_KeyDown"/>

                <StackPanel Grid.Row="6" Margin="0,20,0,0">
                    <Button x:Name="LoginButton" Content="ورود" FontSize="14"
                            Height="44" Cursor="Hand" Click="LoginButton_Click"
                            Background="#0058BC" Foreground="White"/>

                    <Border x:Name="StatusBorder" Visibility="Collapsed" Margin="0,12,0,0"
                            Background="#E3F2FD" Padding="12,8" CornerRadius="6">
                        <TextBlock x:Name="StatusText" Text="" FontSize="12" Foreground="#1565C0"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
