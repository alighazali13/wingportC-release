<UserControl x:Class="GamePort.Cashier.Views.FinancialReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:GamePort.Cashier.Converters"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1100"
             FlowDirection="RightToLeft"
             FontFamily="{StaticResource Vazirmatn}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Small outlined button -->
        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontFamily" Value="{StaticResource Vazirmatn}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Period tab button -->
        <Style x:Key="PeriodTab" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontFamily" Value="{StaticResource Vazirmatn}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small icon button -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24">
        <StackPanel>

            <!-- ===== PAGE HEADER ===== -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="گزارشات مالی و عملکرد سیستم‌ها" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="بررسی و نظارت بر تمامی درآمدها، تسویه‌حساب نشست‌ها و بوفه گیم‌سنتر" FontSize="13"
                               Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Filter & Export -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Period tabs -->
                    <Border Background="#E2E8F0" CornerRadius="10" Padding="4" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="امروز" Style="{StaticResource PeriodTab}" Background="#FFFFFF"
                                    FontWeight="SemiBold" Command="{Binding SetPeriodCommand}" CommandParameter="امروز"/>
                            <Button Content="۷ روز اخیر" Style="{StaticResource PeriodTab}"
                                    Command="{Binding SetPeriodCommand}" CommandParameter="۷ روز"/>
                            <Button Content="ماه جاری" Style="{StaticResource PeriodTab}"
                                    Command="{Binding SetPeriodCommand}" CommandParameter="ماه"/>
                            <Button Content="بازه دلخواه" Style="{StaticResource PeriodTab}"
                                    Command="{Binding SetPeriodCommand}" CommandParameter="دلخواه"/>
                        </StackPanel>
                    </Border>

                    <!-- Export -->
                    <Button Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Command="{Binding ExportExcelCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📥" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="خروجی اکسل" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding PrintInvoiceCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨️" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="چاپ فاکتور" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===== KPI CARDS ===== -->
            <Grid Margin="0,0,0,24">
            <ItemsControl ItemsSource="{Binding KpiCards}">
                <ItemsControl.Effect>
                    <BlurEffect Radius="{Binding BlurRadius}"/>
                </ItemsControl.Effect>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="16" Padding="20" Margin="4,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Label + Change -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,16">
                                    <Border DockPanel.Dock="Right" CornerRadius="99" Padding="8,3"
                                            Margin="8,0,0,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#ECFDF5"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ChangePositive}" Value="False">
                                                        <Setter Property="Background" Value="#F8FAFC"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Change}" FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#059669"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ChangePositive}" Value="False">
                                                                <Setter Property="Foreground" Value="#64748B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text=" ▲" FontSize="10" Foreground="#059669" VerticalAlignment="Bottom">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ChangePositive}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Medium"
                                               Foreground="#94A3B8" VerticalAlignment="Center"/>
                                </DockPanel>

                                <!-- Value -->
                                <StackPanel Grid.Row="1" Margin="0,0,0,4">
                                    <TextBlock FontSize="24" FontWeight="Black" Foreground="#0F172A"
                                               TextWrapping="NoWrap">
                                        <Run Text="{Binding Value}"/>
                                        <Run Text="{Binding Unit}" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding ChangeLabel}" FontSize="11"
                                               Foreground="#94A3B8" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Progress bar -->
                                <Border Grid.Row="2" Height="6" Background="#F1F5F9" CornerRadius="3"
                                        Margin="0,8,0,0">
                                    <Border HorizontalAlignment="Left" CornerRadius="3">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding AccentColor}"/>
                                        </Border.Background>
                                        <Border.Width>
                                            <MultiBinding Converter="{x:Static local:ProgressWidthConverter.Instance}">
                                                <Binding RelativeSource="{RelativeSource AncestorType=Border}" Path="ActualWidth"/>
                                                <Binding Path="Progress"/>
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
                <Border Background="#B3FFFFFF" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}" Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding OpenPinModalCommand}"/>
                    </Border.InputBindings>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="52" Height="52" CornerRadius="26" Background="#E6FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource Icon}" FontSize="24" Foreground="#0058BC" Text="{StaticResource IconLock}"/>
                        </Border>
                        <TextBlock Text="اطلاعات مالی محافظت شده است" FontSize="13" FontWeight="Bold" Foreground="#181C23" HorizontalAlignment="Center"/>
                        <TextBlock Text="برای مشاهده کلیک کنید" FontSize="11" Foreground="#414755" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== CHARTS SECTION ===== -->
            <Grid Margin="0,0,0,24">
            <Grid>
                <Grid.Effect>
                    <BlurEffect Radius="{Binding BlurRadius}"/>
                </Grid.Effect>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Hourly Chart -->
                <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="16" Padding="24" Margin="0,0,12,0">
                    <StackPanel>
                        <!-- Chart header -->
                        <DockPanel Margin="0,0,0,20">
                            <StackPanel DockPanel.Dock="Right">
                                <TextBlock Text="روند فروش و درآمد به تفکیک ساعت" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="پیک مصرف و ورودی وجه در ساعات کاری گیم‌سنتر" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                    <Ellipse Width="10" Height="10" Fill="#5046E5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="پی‌سی گیمینگ" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                    <Ellipse Width="10" Height="10" Fill="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="کنسول‌ها" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="#FBBF24" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="بوفه" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>

                        <!-- Chart Canvas -->
                        <Border Background="#F8FAFC" CornerRadius="8" Margin="0,0,0,8" Height="200" ClipToBounds="True">
                            <Viewbox Stretch="Fill">
                                <Canvas Width="1000" Height="200">
                                    <!-- Grid lines -->
                                    <Line X1="0" Y1="30" X2="1000" Y2="30" Stroke="#E2E8F0" StrokeDashArray="4,4" StrokeThickness="1"/>
                                    <Line X1="0" Y1="80" X2="1000" Y2="80" Stroke="#E2E8F0" StrokeDashArray="4,4" StrokeThickness="1"/>
                                    <Line X1="0" Y1="130" X2="1000" Y2="130" Stroke="#E2E8F0" StrokeDashArray="4,4" StrokeThickness="1"/>
                                    <Line X1="0" Y1="180" X2="1000" Y2="180" Stroke="#E2E8F0" StrokeThickness="1"/>

                                    <!-- Console area fill -->
                                    <Path Fill="#1238BDF8" Data="M 0,170 C 114,160 214,140 314,120 C 429,100 543,130 643,90 C 757,50 886,65 1000,45 L 1000,195 L 0,195 Z"/>

                                    <!-- PC area fill -->
                                    <Path Fill="#125046E5" Data="M 0,150 C 129,140 229,90 343,70 C 457,50 571,80 686,35 C 786,-5 886,20 1000,10 L 1000,195 L 0,195 Z"/>

                                    <!-- Console curve -->
                                    <Path Stroke="#38BDF8" StrokeThickness="2.5" StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 0,170 C 114,160 214,140 314,120 C 429,100 543,130 643,90 C 757,50 886,65 1000,45"/>

                                    <!-- PC curve -->
                                    <Path Stroke="#5046E5" StrokeThickness="3" StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 0,150 C 129,140 229,90 343,70 C 457,50 571,80 686,35 C 786,-5 886,20 1000,10"/>

                                    <!-- Peak indicator -->
                                    <Ellipse Canvas.Left="680" Canvas.Top="29" Width="12" Height="12" Fill="#5046E5" Stroke="White" StrokeThickness="2.5"/>
                                    <Border Canvas.Left="620" Canvas.Top="-2" Background="#1E293B" CornerRadius="6" Padding="10,5">
                                        <TextBlock Text="۱۸:۳۰ | ۷۸۰,۰۰۰ ت" FontSize="10" FontWeight="Bold" Foreground="White" FontFamily="{StaticResource Vazirmatn}"/>
                                    </Border>
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <!-- X-axis labels -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="۱۰:۰۰" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="۱۲:۰۰" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="۱۴:۰۰" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="۱۶:۰۰" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="۱۸:۰۰" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="۲۰:۰۰" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="۲۲:۰۰" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="7" Text="۲۴:۰۰" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Right: Category Breakdown -->
                <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="16" Padding="24">
                    <StackPanel>
                        <!-- Header -->
                        <DockPanel Margin="0,0,0,20">
                            <Border DockPanel.Dock="Right" Background="#EEF2FF" CornerRadius="6" Padding="8,3">
                                <TextBlock Text="تفکیک کل" FontSize="11" FontWeight="Medium" Foreground="#5046E5"/>
                            </Border>
                            <TextBlock Text="سهم بخش‌های درآمدی" FontSize="14" FontWeight="Bold"
                                       Foreground="#0F172A" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Category bars -->
                        <StackPanel Margin="0,0,0,24">
                            <!-- PC -->
                            <Grid Margin="0,0,0,16">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="۵۷٪" FontSize="11" FontWeight="Bold"
                                               Foreground="#0F172A" VerticalAlignment="Center"/>
                                    <StackPanel DockPanel.Dock="Right" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Ellipse Width="10" Height="10" Fill="#5046E5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="سیستم‌های پی‌سی (VIP + عادی)" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#475569"/>
                                        </StackPanel>
                                        <Border Height="8" Background="#F1F5F9" CornerRadius="4">
                                            <Border Width="248" Height="8" Background="#5046E5" CornerRadius="4" HorizontalAlignment="Left"/>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                            </Grid>

                            <!-- PS5 -->
                            <Grid Margin="0,0,0,16">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="۲۴٪" FontSize="11" FontWeight="Bold"
                                               Foreground="#0F172A" VerticalAlignment="Center"/>
                                    <StackPanel DockPanel.Dock="Right" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Ellipse Width="10" Height="10" Fill="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="کنسول‌های بازی (PS5 Rooms)" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#475569"/>
                                        </StackPanel>
                                        <Border Height="8" Background="#F1F5F9" CornerRadius="4">
                                            <Border Width="106" Height="8" Background="#38BDF8" CornerRadius="4" HorizontalAlignment="Left"/>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                            </Grid>

                            <!-- Buffet -->
                            <Grid>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="۱۹٪" FontSize="11" FontWeight="Bold"
                                               Foreground="#0F172A" VerticalAlignment="Center"/>
                                    <StackPanel DockPanel.Dock="Right" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Ellipse Width="10" Height="10" Fill="#FBBF24" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="سفارشات بوفه و کافی‌شاپ" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#475569"/>
                                        </StackPanel>
                                        <Border Height="8" Background="#F1F5F9" CornerRadius="4">
                                            <Border Width="84" Height="8" Background="#FBBF24" CornerRadius="4" HorizontalAlignment="Left"/>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Cashier Summary -->
                        <Border Background="#F8FAFC" CornerRadius="12" Padding="14" Margin="0,4,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}"
                                        Padding="8,4" Foreground="#5046E5" BorderBrush="#C7D2FE"
                                        Command="{Binding PrintInvoiceCommand}">
                                    <TextBlock Text="تسویه صندوق" FontSize="11"/>
                                </Button>
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <Border Width="36" Height="36" CornerRadius="10" Background="#ECFDF5"
                                            Margin="0,0,10,0">
                                        <TextBlock Text="💰" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="موجودی صندوق نقدی" FontSize="11" FontWeight="Medium"
                                                   Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding CashBalance}" FontSize="13" FontWeight="Bold"
                                                   Foreground="#0F172A" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
                <Border Background="#B3FFFFFF" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}" Cursor="Hand" CornerRadius="16">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding OpenPinModalCommand}"/>
                    </Border.InputBindings>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="52" Height="52" CornerRadius="26" Background="#E6FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource Icon}" FontSize="24" Foreground="#0058BC" Text="{StaticResource IconLock}"/>
                        </Border>
                        <TextBlock Text="اطلاعات مالی محافظت شده است" FontSize="13" FontWeight="Bold" Foreground="#181C23" HorizontalAlignment="Center"/>
                        <TextBlock Text="برای مشاهده کلیک کنید" FontSize="11" Foreground="#414755" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== TRANSACTIONS TABLE ===== -->
            <Grid>
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16">
                <Border.Effect>
                    <BlurEffect Radius="{Binding BlurRadius}"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Table toolbar -->
                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Search + filter tabs -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Search -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                        CornerRadius="10" Width="280" Margin="0,0,12,0">
                                    <Grid>
                                        <TextBlock FontFamily="{StaticResource MaterialIcons}" FontSize="16"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Margin="0,0,10,0" Text="&#xE8B6;" Foreground="#94A3B8"/>
                                        <TextBox Background="Transparent" BorderThickness="0" FontSize="12"
                                                 FontFamily="{StaticResource Vazirmatn}"
                                                 VerticalContentAlignment="Center" Padding="32,8,12,8"
                                                 Text="جستجوی شناسه، مشتری، شماره سیستم..."
                                                 Foreground="#94A3B8"/>
                                    </Grid>
                                </Border>

                                <!-- Type filter tabs -->
                                <Border Background="#F1F5F9" CornerRadius="10" Padding="4">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="همه بخش‌ها" Style="{StaticResource PeriodTab}" Background="#FFFFFF" FontWeight="SemiBold"/>
                                        <Button Content="پی‌سی (PC)" Style="{StaticResource PeriodTab}"/>
                                        <Button Content="کنسول (PS)" Style="{StaticResource PeriodTab}"/>
                                        <Button Content="بوفه" Style="{StaticResource PeriodTab}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Status dropdown + refresh -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource OutlineButton}" Padding="12,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="وضعیت: همه تراکنش‌ها" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text=" ▾" FontSize="10" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Margin="8,0,0,0" Padding="8">
                                    <TextBlock Text="🔄" FontSize="14"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Table -->
                    <Grid Margin="20,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="24,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="شناسه / ساعت" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                <TextBlock Grid.Column="1" Text="سیستم یا بخش" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                <TextBlock Grid.Column="2" Text="مشتری / کاربر" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                <TextBlock Grid.Column="3" Text="مدت نشست" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                <TextBlock Grid.Column="4" Text="روش پرداخت" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                <TextBlock Grid.Column="5" Text="مبلغ پرداختی" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                <TextBlock Grid.Column="6" Text="وضعیت تسویه" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="7" Text="عملیات" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"
                                           HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>

                        <!-- Rows -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Transactions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="24,14" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1.6*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1.4*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1.4*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- ID & Time -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Id}" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                                                <TextBlock Text="{Binding Time}" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Device -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="28" Height="28" CornerRadius="8" Margin="0,0,10,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#EFF6FF"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DeviceLabel}" Value="PS5">
                                                                    <Setter Property="Background" Value="#EEF2FF"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DeviceLabel}" Value="بوفه">
                                                                    <Setter Property="Background" Value="#FFFBEB"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DeviceLabel}" Value="شارژ">
                                                                    <Setter Property="Background" Value="#ECFDF5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding DeviceLabel}" FontSize="10" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#2563EB"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DeviceLabel}" Value="PS5">
                                                                        <Setter Property="Foreground" Value="#6366F1"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding DeviceLabel}" Value="بوفه">
                                                                        <Setter Property="Foreground" Value="#D97706"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding DeviceLabel}" Value="شارژ">
                                                                        <Setter Property="Foreground" Value="#059669"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DeviceName}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                                                    <TextBlock Text="{Binding DeviceDetail}" FontSize="10" Foreground="#94A3B8"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Customer -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CustomerName}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                                                <TextBlock Text="{Binding CustomerType}" FontSize="10" Foreground="#94A3B8"/>
                                            </StackPanel>

                                            <!-- Duration -->
                                            <TextBlock Grid.Column="3" Text="{Binding Duration}" FontSize="12"
                                                       Foreground="#475569" VerticalAlignment="Center"/>

                                            <!-- Payment Method -->
                                            <TextBlock Grid.Column="4" Text="{Binding PaymentMethod}" FontSize="12"
                                                       Foreground="#475569" VerticalAlignment="Center"/>

                                            <!-- Amount -->
                                            <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                                <TextBlock FontSize="13" FontWeight="Bold" Foreground="#0F172A">
                                                    <Run Text="{Binding AmountPrefix, Mode=OneWay}"/>
                                                    <Run Text="{Binding Amount, Mode=OneWay}"/>
                                                    <Run Text=" تومان" FontSize="10" FontWeight="Normal" Foreground="#94A3B8"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Status -->
                                            <Border Grid.Column="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#ECFDF5"/>
                                                        <Setter Property="BorderBrush" Value="#D1FAE5"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="CornerRadius" Value="99"/>
                                                        <Setter Property="Padding" Value="10,4"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSettled}" Value="False">
                                                                <Setter Property="Background" Value="#FFFBEB"/>
                                                                <Setter Property="BorderBrush" Value="#FDE68A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#059669"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSettled}" Value="False">
                                                                        <Setter Property="Fill" Value="#D97706"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#059669"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSettled}" Value="False">
                                                                        <Setter Property="Foreground" Value="#D97706"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>

                                            <!-- Actions -->
                                            <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <!-- Settled: view + print -->
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSettled}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <Button Style="{StaticResource IconButton}" Padding="6" Margin="0,0,4,0"
                                                            ToolTip="مشاهده رسید">
                                                        <TextBlock Text="👁" FontSize="12"/>
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}" Padding="6"
                                                            ToolTip="چاپ فاکتور">
                                                        <TextBlock Text="🖨" FontSize="12"/>
                                                    </Button>
                                                </StackPanel>

                                                <!-- Pending: settle button -->
                                                <Button Padding="10,4" FontSize="11"
                                                        Foreground="#5046E5" BorderBrush="#C7D2FE" Margin="0,0,4,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSettled}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock Text="تسویه و بستن" FontSize="11"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Pagination -->
                        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0"
                                Padding="24,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="نمایش ۵ مورد از ۴۸ تراکنش ثبت شده امروز"
                                           FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="قبلی" Style="{StaticResource PeriodTab}" IsEnabled="False"/>
                                    <Border Background="#5046E5" CornerRadius="8" Padding="12,6" Margin="4,0,4,0">
                                        <TextBlock Text="۱" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    <Button Content="۲" Style="{StaticResource PeriodTab}"/>
                                    <Button Content="۳" Style="{StaticResource PeriodTab}"/>
                                    <TextBlock Text="..." FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="4,0"/>
                                    <Button Content="۱۰" Style="{StaticResource PeriodTab}"/>
                                    <Button Content="بعدی" Style="{StaticResource PeriodTab}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
                <Border Background="#B3FFFFFF" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}" Cursor="Hand" CornerRadius="16">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding OpenPinModalCommand}"/>
                    </Border.InputBindings>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="52" Height="52" CornerRadius="26" Background="#E6FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource Icon}" FontSize="24" Foreground="#0058BC" Text="{StaticResource IconLock}"/>
                        </Border>
                        <TextBlock Text="اطلاعات مالی محافظت شده است" FontSize="13" FontWeight="Bold" Foreground="#181C23" HorizontalAlignment="Center"/>
                        <TextBlock Text="برای مشاهده کلیک کنید" FontSize="11" Foreground="#414755" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
