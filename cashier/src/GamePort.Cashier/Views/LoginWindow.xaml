<Window x:Class="GamePort.Cashier.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ورود به وینگ‌پورت"
        Height="560" Width="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        FlowDirection="RightToLeft"
        FontFamily="Vazirmatn"
        Background="#F9F9FF"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="TrafficLightBtn" TargetType="Button">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse Fill="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#0058BC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#B3FFFFFF" MouseLeftButtonDown="Header_MouseDown"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="8,0,0,0" FlowDirection="LeftToRight">
                <Button Style="{StaticResource TrafficLightBtn}" Background="#FF3B30"
                        Click="Close_Click"/>
                <Button Style="{StaticResource TrafficLightBtn}" Background="#FFCC00" Margin="8,0,0,0"
                        Click="Minimize_Click"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="36,20,36,36" VerticalAlignment="Top">
            <Border Width="64" Height="64" CornerRadius="18" Background="#0058BC"
                    HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="&#xE30A;" FontSize="32" Foreground="White" FontFamily="Segoe MDL2 Assets"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="وینگ‌پورت" FontSize="22" FontWeight="Bold" Foreground="#181C23"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="ورود کارمند" FontSize="12" Foreground="#414755"
                       HorizontalAlignment="Center" Margin="0,6,0,28"/>

            <TextBlock Text="نام کاربری" FontSize="12" FontWeight="Medium" Foreground="#414755" Margin="4,0,0,6"/>
            <Border Background="White" CornerRadius="10" BorderBrush="#C1C6D7" BorderThickness="1" Padding="12,0">
                <TextBox x:Name="UsernameBox"
                         Background="Transparent" BorderThickness="0" FontSize="14" Foreground="#181C23"
                         Height="44" VerticalContentAlignment="Center" FlowDirection="LeftToRight"
                         KeyDown="Field_KeyDown"/>
            </Border>

            <TextBlock Text="رمز عبور" FontSize="12" FontWeight="Medium" Foreground="#414755" Margin="4,18,0,6"/>
            <Border Background="White" CornerRadius="10" BorderBrush="#C1C6D7" BorderThickness="1" Padding="12,0">
                <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged"
                             Background="Transparent" BorderThickness="0" FontSize="14" Foreground="#181C23"
                             Height="44" VerticalContentAlignment="Center" FlowDirection="LeftToRight"
                             KeyDown="Field_KeyDown"/>
            </Border>

            <Border x:Name="ErrorBorder" Background="#FFEBEE" CornerRadius="8" Padding="12,8" Margin="4,14,4,0"
                    Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Text="" FontSize="12" Foreground="#BA1A1A" TextWrapping="Wrap"/>
            </Border>

            <Button Content="ورود" Style="{StaticResource PrimaryBtn}" FontSize="15"
                    Margin="0,18,0,0" Click="Login_Click" x:Name="LoginButton"/>

            <TextBlock Text="در حال ورود..." FontSize="12" Foreground="#414755"
                       HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed"
                       x:Name="LoadingText"/>
        </StackPanel>
    </Grid>
</Window>
