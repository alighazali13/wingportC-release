<Window x:Class="GamePort.Cashier.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ورود به وینگ‌پورت"
        Height="560" Width="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource Vazirmatn}"
        Background="Transparent"
        AllowsTransparency="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TrafficLightButton" TargetType="Button">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse Fill="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F9F9FF" CornerRadius="20" BorderBrush="#C1C6D7" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.25" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Height="44" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="16,0,0,0" FlowDirection="LeftToRight">
                    <Button Style="{StaticResource TrafficLightButton}" Background="#FF3B30"
                            Click="Close_Click" ToolTip="بستن"/>
                </StackPanel>
            </Grid>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="36,0,36,36" VerticalAlignment="Top">

                <Border Width="64" Height="64" CornerRadius="18" Background="#0058BC"
                        HorizontalAlignment="Center" Margin="0,4,0,16">
                    <TextBlock Style="{StaticResource Icon}" FontSize="32" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="{StaticResource IconGamepad}"/>
                </Border>

                <TextBlock Text="وینگ‌پورت" FontSize="22" FontWeight="Bold" Foreground="#181C23"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="ورود کارمند به سیستم مدیریت گیم‌سنتر" FontSize="12" Foreground="#414755"
                           HorizontalAlignment="Center" Margin="0,6,0,28"/>

                <TextBlock Text="نام کاربری" FontSize="12" FontWeight="Medium" Foreground="#414755" Margin="4,0,0,6"/>
                <Border Background="White" CornerRadius="10" BorderBrush="#C1C6D7" BorderThickness="1" Padding="12,0">
                    <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0" FontSize="14" Foreground="#181C23"
                             Height="44" VerticalContentAlignment="Center" FlowDirection="LeftToRight"
                             KeyDown="Field_KeyDown"/>
                </Border>

                <TextBlock Text="رمز عبور" FontSize="12" FontWeight="Medium" Foreground="#414755" Margin="4,18,0,6"/>
                <Border Background="White" CornerRadius="10" BorderBrush="#C1C6D7" BorderThickness="1" Padding="12,0">
                    <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged"
                                 Background="Transparent" BorderThickness="0" FontSize="14" Foreground="#181C23"
                                 Height="44" VerticalContentAlignment="Center" FlowDirection="LeftToRight"
                                 KeyDown="Field_KeyDown"/>
                </Border>

                <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="#BA1A1A"
                           TextWrapping="Wrap" Margin="4,16,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button Content="ورود" Style="{StaticResource PrimaryButton}" FontSize="15"
                        Padding="0,12" Margin="0,24,0,0"
                        Command="{Binding LoginCommand}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                <TextBlock Text="در حال ورود..." FontSize="12" Foreground="#414755"
                           HorizontalAlignment="Center" Margin="0,12,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</Window>
