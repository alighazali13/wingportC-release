<UserControl x:Class="GamePort.Cashier.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:GamePort.Cashier.Converters"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1100"
             FlowDirection="RightToLeft"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             FontFamily="{StaticResource Vazirmatn}">

    <UserControl.Resources>
        <local:PercentToWidthConverter x:Key="PercentToWidth"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <local:TextToVisibilityConverter x:Key="TextToVis"/>

        <!-- Filter pill -->
        <Style x:Key="FilterPill" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#414755"/>
            <Setter Property="FontFamily" Value="{StaticResource Vazirmatn}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E6E8F3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Soft icon button -->
        <Style x:Key="SoftButton" TargetType="Button">
            <Setter Property="Background" Value="#F1F3FE"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0E2ED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary small button -->
        <Style x:Key="PrimarySmall" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#0058BC" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Master list item (ListBoxItem) -->
        <Style x:Key="UserListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="14,12"
                                BorderBrush="#26C1C6D7" BorderThickness="0,0,0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#80F1F3FE"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4DD8E2FF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,4,1"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0058BC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= TOP HEADER BAR ================= -->
        <Border Grid.Row="0" Background="White" BorderBrush="#4DC1C6D7" BorderThickness="1" CornerRadius="16"
                Padding="18,14" Margin="0,0,0,18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F1F3FE" BorderBrush="#4DC1C6D7" BorderThickness="1" CornerRadius="12"
                            Padding="14,8" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#0058BC" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="کل کاربران:" FontSize="12" Foreground="#414755" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalUsers}" FontSize="13" FontWeight="Bold" Foreground="#181C23"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                            <Border Background="#1A34C759" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="+۸.۵٪" FontSize="11" FontWeight="Bold" Foreground="#34C759"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Background="#F1F3FE" BorderBrush="#4DC1C6D7" BorderThickness="1" CornerRadius="12"
                            Padding="14,8" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#34C759" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="آنلاین:" FontSize="12" Foreground="#414755" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding OnlineUsers}" FontSize="13" FontWeight="Bold" Foreground="#181C23"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="گیمر" FontSize="12" Foreground="#414755" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#F1F3FE" BorderBrush="#4DC1C6D7" BorderThickness="1" CornerRadius="12"
                            Padding="14,8" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="16" Foreground="#4C4ACA"
                                       Text="{StaticResource IconWallet}" Margin="0,0,8,0"/>
                            <TextBlock Text="کیف‌پول‌ها:" FontSize="12" Foreground="#414755" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding WalletTotal}" FontSize="13" FontWeight="Bold" Foreground="#34C759"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="تومان" FontSize="11" Foreground="#717786" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource PrimarySmall}" Padding="16,10" Margin="6,0,0,0"
                            Command="{Binding AddUserCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="18" Foreground="White"
                                       Text="{StaticResource IconPersonAdd}"/>
                            <TextBlock Text="ثبت مشتری جدید" FontSize="13" FontWeight="SemiBold" Foreground="White"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="12" Background="#D8E2FF">
                        <TextBlock Style="{StaticResource Icon}" FontSize="22" Foreground="#0058BC"
                                   Text="{StaticResource IconGroup}"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="مدیریت کاربران و اعضا" FontSize="20" FontWeight="Bold" Foreground="#181C23"/>
                        <TextBlock Text="نمای Master-Detail مشخصات، اعتبار، وضعیت فعال و گزارش نشست‌های گیمرها"
                                   FontSize="13" Foreground="#414755" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= MASTER-DETAIL ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="360"/>
                <ColumnDefinition Width="7*" MinWidth="480"/>
            </Grid.ColumnDefinitions>

            <!-- ===== MASTER LIST ===== -->
            <Border Grid.Column="0" Background="White" BorderBrush="#4DC1C6D7" BorderThickness="1"
                    CornerRadius="16" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Search -->
                    <Grid Grid.Row="0" Margin="14,14,14,8">
                        <Border Background="#F1F3FE" CornerRadius="12">
                            <Grid>
                                <TextBlock Style="{StaticResource Icon}" FontSize="18" Foreground="#717786"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                           Text="&#xE8B6;"/>
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0" FontSize="13"
                                         FontFamily="{StaticResource Vazirmatn}" Foreground="#181C23"
                                         VerticalContentAlignment="Center" Padding="36,9,36,9"/>
                                <Button HorizontalAlignment="Left" Margin="6,0,0,0" Cursor="Hand"
                                        Background="Transparent" BorderThickness="0"
                                        Command="{Binding ClearSearchCommand}"
                                        Visibility="{Binding SearchText, Converter={StaticResource TextToVis}}">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="16" Foreground="#717786" Text="&#xE5CD;"/>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Filters -->
                    <Border Grid.Row="1" Background="#F1F3FE" CornerRadius="12" Padding="4" Margin="14,0,14,10">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="همه"
                                    Command="{Binding SetTierFilterCommand}" CommandParameter="All">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FilterPill}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTier}" Value="All">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="Foreground" Value="#0058BC"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="VIP (۹۵)"
                                    Command="{Binding SetTierFilterCommand}" CommandParameter="VIP">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FilterPill}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTier}" Value="VIP">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="Foreground" Value="#0058BC"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="طلایی"
                                    Command="{Binding SetTierFilterCommand}" CommandParameter="طلایی">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FilterPill}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTier}" Value="طلایی">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="Foreground" Value="#0058BC"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="عادی"
                                    Command="{Binding SetTierFilterCommand}" CommandParameter="عادی">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FilterPill}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveTier}" Value="عادی">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="Foreground" Value="#0058BC"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Count header -->
                    <Border Grid.Row="2" Background="#80F1F3FE" BorderBrush="#26C1C6D7" BorderThickness="0,0,0,1"
                            Padding="16,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ResultCount}" FontSize="11" Foreground="#717786"/>
                            <TextBlock Text="کاربران مرتب‌شده بر اساس وضعیت فعالیت" FontSize="11" Foreground="#717786"/>
                        </DockPanel>
                    </Border>

                    <!-- List (virtualized) -->
                    <Grid Grid.Row="3">
                        <ListBox ItemsSource="{Binding FilteredUsers}"
                                 SelectedItem="{Binding SelectedUser}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 ItemContainerStyle="{StaticResource UserListItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <!-- Avatar -->
                                                <Grid Width="44" Height="44" Margin="0,0,12,0">
                                                    <Border CornerRadius="22" Background="#E6E8F3">
                                                        <TextBlock Text="{Binding Initials}" FontSize="15" FontWeight="Bold"
                                                                   Foreground="#414755" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Ellipse Width="13" Height="13" HorizontalAlignment="Right"
                                                             VerticalAlignment="Bottom" Stroke="White" StrokeThickness="2">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#717786"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StatusType}" Value="Playing">
                                                                        <Setter Property="Fill" Value="#34C759"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusType}" Value="Reserved">
                                                                        <Setter Property="Fill" Value="#0058BC"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                </Grid>
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="#181C23"/>
                                                        <TextBlock Text="{Binding GamerTag}" FontSize="12" Foreground="#0058BC"
                                                                   FlowDirection="LeftToRight" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                        <Border CornerRadius="4" Padding="6,1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#E0E2ED"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Tier}" Value="VIP">
                                                                            <Setter Property="Background" Value="#1A4C4ACA"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Tier}" Value="طلایی">
                                                                            <Setter Property="Background" Value="#1AFF9500"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Tier}" FontSize="11" FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#414755"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Tier}" Value="VIP">
                                                                                <Setter Property="Foreground" Value="#4C4ACA"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Tier}" Value="طلایی">
                                                                                <Setter Property="Foreground" Value="#FF9500"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                        <TextBlock Text="{Binding UserId}" FontSize="11" Foreground="#717786"
                                                                   FlowDirection="LeftToRight" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                <TextBlock FontSize="13" FontWeight="Bold" HorizontalAlignment="Right">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#34C759"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLowBalance}" Value="True">
                                                                    <Setter Property="Foreground" Value="#BA1A1A"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="{Binding Balance, Mode=OneWay}"/>
                                                    <Run Text=" تومان" FontSize="11" FontWeight="Normal" Foreground="#717786"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Hours}" FontSize="12" Foreground="#717786"
                                                           HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <Border BorderBrush="#26C1C6D7" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,8,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#717786"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StatusType}" Value="Playing">
                                                                        <Setter Property="Fill" Value="#34C759"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusType}" Value="Reserved">
                                                                        <Setter Property="Fill" Value="#0058BC"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="12">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#717786"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StatusType}" Value="Playing">
                                                                        <Setter Property="Foreground" Value="#34C759"/>
                                                                        <Setter Property="FontWeight" Value="Medium"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusType}" Value="Reserved">
                                                                        <Setter Property="Foreground" Value="#0058BC"/>
                                                                        <Setter Property="FontWeight" Value="Medium"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Phone}" FontSize="11"
                                                           Foreground="#717786" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty state -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HasResults, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Style="{StaticResource Icon}" FontSize="40" Foreground="#C1C6D7"
                                       Text="&#xE8B6;" HorizontalAlignment="Center"/>
                            <TextBlock Text="کاربری یافت نشد" FontSize="14" FontWeight="SemiBold" Foreground="#414755"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock Text="عبارت جستجو یا فیلتر را تغییر دهید" FontSize="12" Foreground="#717786"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Pagination -->
                    <Border Grid.Row="4" Background="#80F1F3FE" BorderBrush="#26C1C6D7" BorderThickness="0,1,0,0"
                            Padding="16,10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="›" Style="{StaticResource FilterPill}" IsEnabled="False" FontSize="14"/>
                                <Border Background="#0058BC" CornerRadius="6" Padding="9,3" Margin="4,0">
                                    <TextBlock Text="۱" FontSize="12" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <Border Background="#F1F3FE" CornerRadius="6" Padding="9,3" Margin="4,0">
                                    <TextBlock Text="۲" FontSize="12" Foreground="#414755"/>
                                </Border>
                                <Button Content="‹" Style="{StaticResource FilterPill}" FontSize="14"/>
                            </StackPanel>
                            <TextBlock Text="صفحه ۱ از ۱۲۸" FontSize="11" Foreground="#717786" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== DETAIL PANEL ===== -->
            <Border Grid.Column="1" Background="White" BorderBrush="#4DC1C6D7" BorderThickness="1" CornerRadius="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel DataContext="{Binding SelectedUser}" Margin="20">

                        <!-- Profile header -->
                        <DockPanel Margin="0,0,0,16">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource PrimarySmall}" Padding="14,9" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="16" Foreground="White" Text="&#xE870;"/>
                                        <TextBlock Text="شارژ سریع" FontSize="12" FontWeight="SemiBold" Foreground="White"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SoftButton}" Padding="9,9" Margin="0,0,6,0" ToolTip="ارسال پیام">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="18" Foreground="#717786" Text="&#xE0B7;"/>
                                </Button>
                                <Button Style="{StaticResource SoftButton}" Padding="9,9" Margin="0,0,6,0" ToolTip="تغییر سطح عضویت">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="18" Foreground="#717786" Text="&#xE0FC;"/>
                                </Button>
                                <Button Style="{StaticResource SoftButton}" Padding="9,9" ToolTip="ویرایش">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="18" Foreground="#717786" Text="&#xE3C9;"/>
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Grid Width="64" Height="64" Margin="0,0,16,0">
                                    <Border CornerRadius="16" Background="#E6E8F3">
                                        <TextBlock Text="{Binding Initials}" FontSize="22" FontWeight="Bold"
                                                   Foreground="#414755" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Ellipse Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                             Stroke="White" StrokeThickness="2">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#717786"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusType}" Value="Playing">
                                                        <Setter Property="Fill" Value="#34C759"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusType}" Value="Reserved">
                                                        <Setter Property="Fill" Value="#0058BC"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" Foreground="#181C23"/>
                                        <Border CornerRadius="99" Padding="10,3" Margin="10,0,0,0" VerticalAlignment="Center"
                                                Background="#1A4C4ACA">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" FontSize="13" Foreground="#4C4ACA" Text="&#xE5A2;"/>
                                                <TextBlock Text="{Binding Tier, StringFormat={}عضو {0}}" FontSize="12" FontWeight="Bold"
                                                           Foreground="#4C4ACA" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="{Binding GamerTag}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#0058BC" FlowDirection="LeftToRight"/>
                                        <TextBlock Text="•" FontSize="12" Foreground="#717786" Margin="8,0"/>
                                        <TextBlock Text="{Binding UserId}" FontSize="12" Foreground="#717786"
                                                   FlowDirection="LeftToRight"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#717786"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusType}" Value="Playing">
                                                            <Setter Property="Fill" Value="#34C759"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusType}" Value="Reserved">
                                                            <Setter Property="Fill" Value="#0058BC"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding DeviceInfo}" FontSize="12" Foreground="#34C759" FontWeight="Medium"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>

                        <Border BorderBrush="#26C1C6D7" BorderThickness="0,1,0,0" Margin="0,0,0,16"/>

                        <!-- Wallet + loyalty -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Wallet -->
                            <Border Grid.Column="0" CornerRadius="12" Padding="16" Margin="0,0,12,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                                        <GradientStop Color="#1A0058BC" Offset="0"/>
                                        <GradientStop Color="#F1F3FE" Offset="0.6"/>
                                        <GradientStop Color="#F1F3FE" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#330058BC"/>
                                </Border.BorderBrush>
                                <Border.BorderThickness>1</Border.BorderThickness>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="40" Height="40" CornerRadius="12" Background="#0058BC" Margin="0,0,12,0">
                                            <TextBlock Style="{StaticResource Icon}" FontSize="20" Foreground="White"
                                                       Text="{StaticResource IconWallet}"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="موجودی کیف‌پول فعال" FontSize="12" Foreground="#414755"/>
                                            <TextBlock FontSize="22" FontWeight="Bold" Foreground="#34C759" Margin="0,2,0,0">
                                                <Run Text="{Binding Balance, Mode=OneWay}"/>
                                                <Run Text=" تومان" FontSize="12" FontWeight="Normal" Foreground="#717786"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
                                        <Button Style="{StaticResource SoftButton}" Padding="14,8" Margin="0,0,8,0"
                                                Background="White" ToolTip="تسویه">
                                            <TextBlock Text="تسویه" FontSize="12" FontWeight="SemiBold" Foreground="#181C23"/>
                                        </Button>
                                        <Button Style="{StaticResource PrimarySmall}" Padding="14,8">
                                            <TextBlock Text="+ شارژ حساب" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Loyalty -->
                            <Border Grid.Column="1" Background="#F1F3FE" BorderBrush="#4DC1C6D7" BorderThickness="1"
                                    CornerRadius="12" Padding="16">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="امتیاز وفاداری باشگاه" FontSize="12" Foreground="#717786"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding LoyaltyPoints}" FontSize="22" FontWeight="Bold" Foreground="#4C4ACA"/>
                                        <TextBlock Text="XP" FontSize="12" FontWeight="Medium" Foreground="#4C4ACA"
                                                   Margin="6,0,0,0" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                    <Border Height="6" Background="#E0E2ED" CornerRadius="3" Margin="0,10,0,0">
                                        <Border HorizontalAlignment="Right" Width="90" Height="6" Background="#4C4ACA" CornerRadius="3"/>
                                    </Border>
                                    <TextBlock Text="۱۱۰ امتیاز تا پاداش بعدی" FontSize="11" Foreground="#717786" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Identity grid -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#F1F3FE" CornerRadius="12" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="شماره تماس" FontSize="11" Foreground="#717786"/>
                                    <TextBlock Text="{Binding Phone}" FontSize="13" FontWeight="SemiBold" Foreground="#181C23" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#F1F3FE" CornerRadius="12" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="تاریخ عضویت" FontSize="11" Foreground="#717786"/>
                                    <TextBlock Text="{Binding JoinDate}" FontSize="13" FontWeight="SemiBold" Foreground="#181C23" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#F1F3FE" CornerRadius="12" Padding="12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="کل زمان حضور" FontSize="11" Foreground="#717786"/>
                                    <TextBlock Text="{Binding TotalTime}" FontSize="13" FontWeight="SemiBold" Foreground="#181C23"
                                               Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Background="#F1F3FE" CornerRadius="12" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="تخفیف اشتراک" FontSize="11" Foreground="#717786"/>
                                    <TextBlock Text="{Binding Discount}" FontSize="13" FontWeight="SemiBold" Foreground="#4C4ACA"
                                               Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Favorite games + rank -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#F1F3FE" CornerRadius="12" Padding="16" Margin="0,0,8,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,14">
                                        <TextBlock DockPanel.Dock="Right" Text="۳ عنوان برتر" FontSize="11" Foreground="#717786"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" FontSize="18" Foreground="#0058BC"
                                                       Text="{StaticResource IconGames}" Margin="0,0,6,0"/>
                                            <TextBlock Text="بازی‌های محبوب" FontSize="14" FontWeight="Bold" Foreground="#181C23"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding FavoriteGames}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,12">
                                                    <DockPanel Margin="0,0,0,6">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Hours}" FontSize="11"
                                                                   Foreground="#414755"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#181C23"/>
                                                    </DockPanel>
                                                    <Border Height="8" Background="#E0E2ED" CornerRadius="4">
                                                        <Border HorizontalAlignment="Right" Height="8" CornerRadius="4"
                                                                Background="{Binding Color}"
                                                                Width="{Binding Percent, Converter={StaticResource PercentToWidth}, ConverterParameter=220}"/>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#F1F3FE" CornerRadius="12" Padding="16" Margin="8,0,0,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,14">
                                        <Border DockPanel.Dock="Right" Background="#1A0058BC" CornerRadius="6" Padding="8,3">
                                            <TextBlock Text="{Binding Rank}" FontSize="11" FontWeight="Bold" Foreground="#0058BC"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" FontSize="18" Foreground="#4C4ACA"
                                                       Text="&#xE0FC;" Margin="0,0,6,0"/>
                                            <TextBlock Text="جایگاه ماهانه" FontSize="14" FontWeight="Bold" Foreground="#181C23"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <Border Background="White" CornerRadius="12" Padding="12" Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="32" Height="32" CornerRadius="16" Background="#1AFF9500" Margin="0,0,10,0">
                                                <TextBlock Text="۲" FontSize="13" FontWeight="Bold" Foreground="#FF9500"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="برترین گیمرهای آبان ۱۴۰۳" FontSize="12" FontWeight="SemiBold" Foreground="#181C23"/>
                                                <TextBlock Text="{Binding MonthlyHours}" FontSize="11" Foreground="#717786" Margin="0,3,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="مشتری خوش‌حساب" FontSize="11" Foreground="#34C759"
                                                   FontWeight="Medium"/>
                                        <TextBlock FontSize="11" Foreground="#717786">
                                            <Run Text="سیستم: "/>
                                            <Run Text="{Binding FavoriteSystem, Mode=OneWay}" Foreground="#181C23"/>
                                        </TextBlock>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Sessions -->
                        <Border Background="#F1F3FE" CornerRadius="12" Padding="16" Margin="0,16,0,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <TextBlock DockPanel.Dock="Right" Text="مشاهده آرشیو کامل" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#0058BC" Cursor="Hand" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="18" Foreground="#0058BC"
                                                   Text="&#xE889;" Margin="0,0,6,0"/>
                                        <TextBlock Text="نشست‌ها و تراکنش‌های اخیر" FontSize="14" FontWeight="Bold" Foreground="#181C23"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="دستگاه / خدمت" FontSize="11" Foreground="#717786"/>
                                    <TextBlock Grid.Column="1" Text="تاریخ و زمان" FontSize="11" Foreground="#717786"/>
                                    <TextBlock Grid.Column="2" Text="مدت زمان" FontSize="11" Foreground="#717786"/>
                                    <TextBlock Grid.Column="3" Text="مبلغ کسر شده" FontSize="11" Foreground="#717786"/>
                                    <TextBlock Grid.Column="4" Text="وضعیت" FontSize="11" Foreground="#717786"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Sessions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#26C1C6D7" BorderThickness="0,1,0,0" Padding="0,10">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SessionType}" Value="Active">
                                                                <Setter Property="Background" Value="#0D34C759"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="1.4*"/>
                                                        <ColumnDefinition Width="1.3*"/>
                                                        <ColumnDefinition Width="1.5*"/>
                                                        <ColumnDefinition Width="1*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="Transparent"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SessionType}" Value="Active">
                                                                            <Setter Property="Fill" Value="#34C759"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding Device}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="#181C23" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding DateTime}" FontSize="11"
                                                               Foreground="#717786" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Duration}" FontSize="11"
                                                               Foreground="#414755" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Amount}" FontSize="11"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#BA1A1A"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SessionType}" Value="Recharge">
                                                                        <Setter Property="Foreground" Value="#34C759"/>
                                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding SessionType}" Value="Active">
                                                                        <Setter Property="Foreground" Value="#414755"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Border Grid.Column="4" CornerRadius="99" Padding="8,2" HorizontalAlignment="Left"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#E0E2ED"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SessionType}" Value="Active">
                                                                        <Setter Property="Background" Value="#1A34C759"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding SessionType}" Value="Recharge">
                                                                        <Setter Property="Background" Value="#1A0058BC"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#717786"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SessionType}" Value="Active">
                                                                            <Setter Property="Foreground" Value="#34C759"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding SessionType}" Value="Recharge">
                                                                            <Setter Property="Foreground" Value="#0058BC"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
